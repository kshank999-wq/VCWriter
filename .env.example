# VC Writer — environment template.
# Copy to .env.local (web) / .env (tooling) and fill in per environment.
# NEVER commit real credentials. Production values live in Vercel/Supabase/GitHub secrets.

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or the desktop client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------------
# All four must come from the SAME mode. Test and live are separate worlds: a
# sk_test_ key with a live price id fails with "No such price", and a signing
# secret belongs to one webhook endpoint in one mode. There is no publishable
# key — checkout is Stripe's own hosted page and the browser holds no Stripe key.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# The two desktop plans, both RECURRING prices on one product (addendum 32).
# Absent means checkout 500s. `STRIPE_PRICE_ID_DESKTOP` was the one-off price
# and is gone: a recurring price is not the same object under another name.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Recurring price for one Writers Room seat. Absent only stops billed seats.
STRIPE_PRICE_ID_SEAT=

# --- Resend -------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS="VC Writer <noreply@example.com>"

# --- Release delivery ---------------------------------------------------
# Storage bucket holding signed installers; downloads are served as short-lived signed URLs.
RELEASE_BUCKET=vcwriter-releases
RELEASE_DOWNLOAD_TTL_SECONDS=900

# --- AI (Final Editor structural pass) ----------------------------------
# Server-side only. Absent means /api/ai/scene-review returns 503 and the
# Final Editor still runs its deterministic pass.
ANTHROPIC_API_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
