{
  "name": "vcwriter",
  "version": "0.1.0",
  "private": true,
  "description": "VC Writer \u2014 story development, drafting, editing and playback platform for screenwriters and novelists",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:desktop": "pnpm --filter @vcwriter/desktop dev",
    "dev:web": "pnpm --filter @vcwriter/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
