{"formatVersion":3,"generator":"vcwriter","savedAt":"2026-11-12T04:52:00.311Z","project":{"id":"91366f2b-1226-4a73-a01a-5bde1d7868ce","ownerId":null,"format":"short_story","title":"Tales of Mystery","author":"Edgar Allan Poe","logline":"","elevatorPitch":"","synopsis":"","genre":"","notes":"Imported from plain text.","status":"development","posterAssetId":null,"lastOpenedAt":null,"mooring":null,"createdAt":"2026-11-12T04:52:00.311Z","updatedAt":"2026-11-12T04:52:00.323Z"},"settings":{"narratorVoice":null,"autosaveIntervalMs":5000,"snapshotEveryNSaves":20,"includeBeatTitlesInExport":false,"focusMode":false,"markerNumbering":"","markerSymbol":"❦","sectionNumbering":"decimal","outlineCase":"as_typed","includeChapterPagesInExport":true,"paragraphStyle":"indented","scriptFormat":"us","formatOverrides":{"templateName":"","elements":{}},"actBreaks":false,"maxSeconds":0,"episodeCarry":{},"editorIgnoredRules":[],"editorAllowedWords":[],"storyGrid":{},"titlePage":{"title":"","titleImage":"","episode":"","descriptor":"","byline":"","credits":[],"author":"","source":"","sourceAuthor":"","contact":"","draftDate":"","revision":"","notes":""},"castPage":{"heading":"","order":"appearance","time":"","place":"","notes":""},"chapterPageStyle":{},"book":{},"citations":{}},"tracks":[{"id":"fcf629ba-c617-4138-bb04-a2e2f16f1327","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","name":"Main Plot","kind":"main_plot","color":"#c9a45c","description":"","arc":"","orderKey":"V","collapsed":false,"createdAt":"2026-11-12T04:52:00.311Z","updatedAt":"2026-11-12T04:52:00.311Z"}],"units":[{"id":"ba9753a5-2998-46ad-998c-08dc0da669b1","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","trackId":"fcf629ba-c617-4138-bb04-a2e2f16f1327","kind":"chapter","title":"The Tell-Tale Heart","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"V","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","trackId":"fcf629ba-c617-4138-bb04-a2e2f16f1327","kind":"chapter","title":"The Cask of Amontillado","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"l","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"da3adab4-b79b-463f-846d-44925a287cfc","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","trackId":"fcf629ba-c617-4138-bb04-a2e2f16f1327","kind":"chapter","title":"The Masque of the Red Death","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"t","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"}],"beats":[{"id":"7c1bdf2b-2c6c-4067-a3fd-a934b8c566de","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"True!—nervous—very, very dreadfully nervous I had…","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"e014bdb1-c2a3-46e9-af48-65e7bbf5db50","type":"paragraph","text":"True!—nervous—very, very dreadfully nervous I had been and am; but why will you say that I am mad? The disease had sharpened my senses—not destroyed—not dulled them. Above all was the sense of hearing acute. I heard all things in the heaven and in the earth. I heard many things in hell. How, then, am I mad? Hearken! and observe how healthily—how calmly I can tell you the whole story.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c62a6c0a-64f9-478a-bbd5-3590c1c0019a","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"It is impossible to say how…","summary":"","status":"written","orderKey":"l","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"126c6507-a027-465f-975e-d49f9d680f07","type":"paragraph","text":"It is impossible to say how first the idea entered my brain; but once conceived, it haunted me day and night. Object there was none. Passion there was none. I loved the old man. He had never wronged me. He had never given me insult. For his gold I had no desire. I think it was his eye! yes, it was this! He had the eye of a vulture—a pale blue eye, with a film over it. Whenever it fell upon me, my blood ran cold; and so by degrees—very gradually—I made up my mind to take the life of the old man, and thus rid myself of the eye forever.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"246c423e-b03f-4ff5-869d-c6b94d85e4de","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"Now this is the point. You…","summary":"","status":"written","orderKey":"t","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"0518f0c7-e735-4e45-a1e5-1350bab86ff4","type":"paragraph","text":"Now this is the point. You fancy me mad. Madmen know nothing. But you should have seen me. You should have seen how wisely I proceeded—with what caution—with what foresight—with what dissimulation I went to work! I was never kinder to the old man than during the whole week before I killed him. And every night, about midnight, I turned the latch of his door and opened it—oh, so gently! And then, when I had made an opening sufficient for my head, I put in a dark lantern, all closed, closed, that no light shone out, and then I thrust in my head. Oh, you would have laughed to see how cunningly I thrust it in! I moved it slowly—very, very slowly, so that I might not disturb the old man’s sleep. It took me an hour to place my whole head within the opening so far that I could see him as he lay upon his bed. Ha!—would a madman have been so wise as this? And then, when my head was well in the room, I undid the lantern cautiously—oh, so cautiously—cautiously (for the hinges creaked)—I undid it just so much that a single thin ray fell upon the vulture eye. And this I did for seven long nights—every night just at midnight—but I found the eye always closed; and so it was impossible to do the work; for it was not the old man who vexed me, but his Evil Eye. And every morning, when the day broke, I went boldly into the chamber, and spoke courageously to him, calling him by name in a hearty tone, and inquiring how he has passed the night. So you see he would have been a very profound old man, indeed, to suspect that every night, just at twelve, I looked in upon him while he slept.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c1c36d2d-33a1-477b-858c-aff8ba22adbf","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"Upon the eighth night I was…","summary":"","status":"written","orderKey":"x","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"708a8245-ab81-4054-8afb-d1ea82a9f010","type":"paragraph","text":"Upon the eighth night I was more than usually cautious in opening the door. A watch’s minute hand moves more quickly than did mine. Never before that night had I felt the extent of my own powers—of my sagacity. I could scarcely contain my feelings of triumph. To think that there I was, opening the door, little by little, and he not even to dream of my secret deeds or thoughts. I fairly chuckled at the idea; and perhaps he heard me; for he moved on the bed suddenly, as if startled. Now you may think that I drew back—but no. His room was as black as pitch with the thick darkness, (for the shutters were close fastened, through fear of robbers,) and so I knew that he could not see the opening of the door, and I kept pushing it on steadily, steadily.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b13b837d-184a-438e-858a-0ab3fa45ce54","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"I had my head in, and…","summary":"","status":"written","orderKey":"z","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"28d5168f-0a45-4c56-ac1d-b9c7474751c0","type":"paragraph","text":"I had my head in, and was about to open the lantern, when my thumb slipped upon the tin fastening, and the old man sprang up in bed, crying out—“Who’s there?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"72cb44d7-0845-400c-8ab4-e17f7ad8d411","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"I kept quite still and said…","summary":"","status":"written","orderKey":"zV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"2fac6885-06f6-4325-8bc8-b8104fb64680","type":"paragraph","text":"I kept quite still and said nothing. For a whole hour I did not move a muscle, and in the meantime I did not hear him lie down. He was still sitting up in the bed listening;—just as I have done, night after night, hearkening to the death watches in the wall.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"9dc00c2f-83ba-425c-8008-57636ab20452","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"Presently I heard a slight groan,…","summary":"","status":"written","orderKey":"zl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"bea45d3a-611c-4f32-b3d3-6017a21c7262","type":"paragraph","text":"Presently I heard a slight groan, and I knew it was the groan of mortal terror. It was not a groan of pain or of grief—oh, no!—it was the low stifled sound that arises from the bottom of the soul when overcharged with awe. I knew the sound well. Many a night, just at midnight, when all the world slept, it has welled up from my own bosom, deepening, with its dreadful echo, the terrors that distracted me. I say I knew it well. I knew what the old man felt, and pitied him, although I chuckled at heart. I knew that he had been lying awake ever since the first slight noise, when he had turned in the bed. His fears had been ever since growing upon him. He had been trying to fancy them causeless, but could not. He had been saying to himself—“It is nothing but the wind in the chimney—it is only a mouse crossing the floor,” or “It is merely a cricket which has made a single chirp.” Yes, he had been trying to comfort himself with these suppositions: but he had found all in vain. All in vain; because Death, in approaching him had stalked with his black shadow before him, and enveloped the victim. And it was the mournful influence of the unperceived shadow that caused him to feel—although he neither saw nor heard—to feel the presence of my head within the room.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"eafdef59-5828-488e-820d-32f549347dfb","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"When I had waited a long…","summary":"","status":"written","orderKey":"zt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"0548dbff-9bf3-4e00-8e0f-84baba91a6e9","type":"paragraph","text":"When I had waited a long time, very patiently, without hearing him lie down, I resolved to open a little—a very, very little crevice in the lantern. So I opened it—you cannot imagine how stealthily, stealthily—until, at length a single dim ray, like the thread of the spider, shot from out the crevice and fell full upon the vulture eye.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"773ad095-fd71-4734-9acd-2074fe3642c2","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"It was open—wide, wide open—and I…","summary":"","status":"written","orderKey":"zx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9dc151ae-2f5b-49ac-890f-70828221864d","type":"paragraph","text":"It was open—wide, wide open—and I grew furious as I gazed upon it. I saw it with perfect distinctness—all a dull blue, with a hideous veil over it that chilled the very marrow in my bones; but I could see nothing else of the old man’s face or person: for I had directed the ray as if by instinct, precisely upon the damned spot.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"64908d2d-062a-49e9-820c-945bac2b8103","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"And have I not told you…","summary":"","status":"written","orderKey":"zz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"efbff4cb-a879-4c82-8933-ecb0f7c4de3b","type":"paragraph","text":"And have I not told you that what you mistake for madness is but over-acuteness of the sense?—now, I say, there came to my ears a low, dull, quick sound, such as a watch makes when enveloped in cotton. I knew that sound well, too. It was the beating of the old man’s heart. It increased my fury, as the beating of a drum stimulates the soldier into courage.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"912767f6-06c7-4e16-8b0b-5213782aafa9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"But even yet I refrained and…","summary":"","status":"written","orderKey":"zzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"11177fbc-333e-4c72-ab86-11cbb24cc227","type":"paragraph","text":"But even yet I refrained and kept still. I scarcely breathed. I held the lantern motionless. I tried how steadily I could maintain the ray upon the eye. Meantime the hellish tattoo of the heart increased. It grew quicker and quicker, and louder and louder every instant. The old man’s terror must have been extreme! It grew louder, I say, louder every moment!—do you mark me well? I have told you that I am nervous: so I am. And now at the dead hour of the night, amid the dreadful silence of that old house, so strange a noise as this excited me to uncontrollable terror. Yet, for some minutes longer I refrained and stood still. But the beating grew louder, louder! I thought the heart must burst. And now a new anxiety seized me—the sound would be heard by a neighbour! The old man’s hour had come! With a loud yell, I threw open the lantern and leaped into the room. He shrieked once—once only. In an instant I dragged him to the floor, and pulled the heavy bed over him. I then smiled gaily, to find the deed so far done. But, for many minutes, the heart beat on with a muffled sound. This, however, did not vex me; it would not be heard through the wall. At length it ceased. The old man was dead. I removed the bed and examined the corpse. Yes, he was stone, stone dead. I placed my hand upon the heart and held it there many minutes. There was no pulsation. He was stone dead. His eye would trouble me no more.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f03fd7f9-b0b7-4339-88ea-ba8a3b258416","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"If still you think me mad,…","summary":"","status":"written","orderKey":"zzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8c3b83d0-17cf-4943-83d8-334c48d54eb4","type":"paragraph","text":"If still you think me mad, you will think so no longer when I describe the wise precautions I took for the concealment of the body. The night waned, and I worked hastily, but in silence. First of all I dismembered the corpse. I cut off the head and the arms and the legs.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"4fbb40ba-84a6-4c32-8fa1-6206a0f7540c","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"I then took up three planks…","summary":"","status":"written","orderKey":"zzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"1e5805de-a2ca-4b9c-a0b5-e31e4d23501b","type":"paragraph","text":"I then took up three planks from the flooring of the chamber, and deposited all between the scantlings. I then replaced the boards so cleverly, so cunningly, that no human eye—not even his—could have detected any thing wrong. There was nothing to wash out—no stain of any kind—no blood-spot whatever. I had been too wary for that. A tub had caught all—ha! ha!","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"79107bbc-7527-41c7-85a6-c1d84cc9bb60","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"When I had made an end…","summary":"","status":"written","orderKey":"zzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"27baab1b-ffc9-485b-b1e1-363e33662202","type":"paragraph","text":"When I had made an end of these labors, it was four o’clock—still dark as midnight. As the bell sounded the hour, there came a knocking at the street door. I went down to open it with a light heart,—for what had I now to fear? There entered three men, who introduced themselves, with perfect suavity, as officers of the police. A shriek had been heard by a neighbour during the night; suspicion of foul play had been aroused; information had been lodged at the police office, and they (the officers) had been deputed to search the premises.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"aa73d015-e93d-439c-8eb0-3e5d376c5889","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"I smiled,—for what had I to…","summary":"","status":"written","orderKey":"zzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"126132a4-0ffd-46d9-b6e3-4dfc8a037a7e","type":"paragraph","text":"I smiled,—for what had I to fear? I bade the gentlemen welcome. The shriek, I said, was my own in a dream. The old man, I mentioned, was absent in the country. I took my visitors all over the house. I bade them search—search well. I led them, at length, to his chamber. I showed them his treasures, secure, undisturbed. In the enthusiasm of my confidence, I brought chairs into the room, and desired them here to rest from their fatigues, while I myself, in the wild audacity of my perfect triumph, placed my own seat upon the very spot beneath which reposed the corpse of the victim.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"42d34aef-2e48-4477-bcae-6e6edf637faf","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"The officers were satisfied. My manner…","summary":"","status":"written","orderKey":"zzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"cf6d6497-3821-4662-8638-0a76c1f552be","type":"paragraph","text":"The officers were satisfied. My manner had convinced them. I was singularly at ease. They sat, and while I answered cheerily, they chatted of familiar things. But, ere long, I felt myself getting pale and wished them gone. My head ached, and I fancied a ringing in my ears: but still they sat and still chatted. The ringing became more distinct:—it continued and became more distinct: I talked more freely to get rid of the feeling: but it continued and gained definiteness—until, at length, I found that the noise was not within my ears.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"1c89eadb-2ae2-4686-8a90-49c70d37c6d2","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"No doubt I now grew _very_…","summary":"","status":"written","orderKey":"zzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"eebc58c0-778f-4e16-a171-e4f9ce8d480d","type":"paragraph","text":"No doubt I now grew _very_ pale;—but I talked more fluently, and with a heightened voice. Yet the sound increased—and what could I do? It was a low, dull, quick sound—much such a sound as a watch makes when enveloped in cotton. I gasped for breath—and yet the officers heard it not. I talked more quickly—more vehemently; but the noise steadily increased. I arose and argued about trifles, in a high key and with violent gesticulations; but the noise steadily increased. Why would they not be gone? I paced the floor to and fro with heavy strides, as if excited to fury by the observations of the men—but the noise steadily increased. Oh God! what could I do? I foamed—I raved—I swore! I swung the chair upon which I had been sitting, and grated it upon the boards, but the noise arose over all and continually increased. It grew louder—louder—louder! And still the men chatted pleasantly, and smiled. Was it possible they heard not? Almighty God!—no, no! They heard!—they suspected!—they knew!—they were making a mockery of my horror!—this I thought, and this I think. But anything was better than this agony! Anything was more tolerable than this derision! I could bear those hypocritical smiles no longer! I felt that I must scream or die! and now—again!—hark! louder! louder! louder! _louder!_","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"49b88a8e-cdff-4294-8223-8b144181dd02","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","title":"“Villains!” I shrieked, “dissemble no more!…","summary":"","status":"written","orderKey":"zzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"3afcd96b-8a09-4220-b940-b10b52c50fb3","type":"paragraph","text":"“Villains!” I shrieked, “dissemble no more! I admit the deed!—tear up the planks!—here, here!—It is the beating of his hideous heart!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"8204ef3e-8925-4f9a-a307-d1b4181b58cc","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"The thousand injuries of Fortunato I…","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"7b5202bd-e0bd-486b-9ae5-9a5f118fc15c","type":"paragraph","text":"The thousand injuries of Fortunato I had borne as I best could; but when he ventured upon insult, I vowed revenge. You, who so well know the nature of my soul, will not suppose, however, that I gave utterance to a threat. _At length_ I would be avenged; this was a point definitively settled—but the very definitiveness with which it was resolved, precluded the idea of risk. I must not only punish, but punish with impunity. A wrong is unredressed when retribution overtakes its redresser. It is equally unredressed when the avenger fails to make himself felt as such to him who has done the wrong.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"8a93779e-cb93-4b5f-8a96-e51dac8f2fee","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"It must be understood, that neither…","summary":"","status":"written","orderKey":"l","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"376aeba2-0bf6-48fa-a268-6edfad799763","type":"paragraph","text":"It must be understood, that neither by word nor deed had I given Fortunato cause to doubt my good will. I continued, as was my wont, to smile in his face, and he did not perceive that my smile _now_ was at the thought of his immolation.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"5a9ac76f-9362-43c3-ae75-86cc6b5d1f5c","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"He had a weak point—this Fortunato—although…","summary":"","status":"written","orderKey":"t","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"bb8d5ad7-cba7-4881-aed3-ce740351f39f","type":"paragraph","text":"He had a weak point—this Fortunato—although in other regards he was a man to be respected and even feared. He prided himself on his connoisseurship in wine. Few Italians have the true virtuoso spirit. For the most part their enthusiasm is adopted to suit the time and opportunity—to practise imposture upon the British and Austrian _millionaires_. In painting and gemmary, Fortunato, like his countrymen, was a quack—but in the matter of old wines he was sincere. In this respect I did not differ from him materially: I was skilful in the Italian vintages myself, and bought largely whenever I could.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0319daca-6ec4-4fa4-b2b1-fcccf7162878","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"It was about dusk, one evening…","summary":"","status":"written","orderKey":"x","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"302dcd2d-e439-493c-9777-27c46a09d507","type":"paragraph","text":"It was about dusk, one evening during the supreme madness of the carnival season, that I encountered my friend. He accosted me with excessive warmth, for he had been drinking much. The man wore motley. He had on a tight-fitting parti-striped dress, and his head was surmounted by the conical cap and bells. I was so pleased to see him, that I thought I should never have done wringing his hand.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"cbca902e-449e-4486-b24f-3252fdd3b5b8","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"I said to him: “My dear…","summary":"","status":"written","orderKey":"z","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"1122d513-da59-4cb9-9a78-580891ca0ec0","type":"paragraph","text":"I said to him: “My dear Fortunato, you are luckily met. How remarkably well you are looking to-day! But I have received a pipe of what passes for Amontillado, and I have my doubts.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"ab48f965-92a7-4d4a-ae41-89192bfb7949","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“How?” said he. “Amontillado? A pipe?…","summary":"","status":"written","orderKey":"zV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"4aff696a-4114-4aa8-972c-a241d65a32d0","type":"paragraph","text":"“How?” said he. “Amontillado? A pipe? Impossible! And in the middle of the carnival!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"d6c39da8-8d3b-4a3a-99ef-f88f5d9be0fa","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“I have my doubts,” I replied;…","summary":"","status":"written","orderKey":"zl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"35195de4-9548-4e29-b37b-6795da2e2691","type":"paragraph","text":"“I have my doubts,” I replied; “and I was silly enough to pay the full Amontillado price without consulting you in the matter. You were not to be found, and I was fearful of losing a bargain.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"117b390f-a449-43bd-a195-c6a07ba942ff","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Amontillado!”","summary":"","status":"written","orderKey":"zt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"d1bc9eed-86ef-4807-8e4a-c43dbd5574ba","type":"paragraph","text":"“Amontillado!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"59702245-5c2b-4af4-a837-07c9635a835f","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“I have my doubts.”","summary":"","status":"written","orderKey":"zx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"fa420ded-170b-4636-baf8-fff8d7803b76","type":"paragraph","text":"“I have my doubts.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"21410be2-3d46-4fff-ac48-6c44ad91d636","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Amontillado!”","summary":"","status":"written","orderKey":"zz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"80876878-80d6-40bf-bc86-2631b760fb46","type":"paragraph","text":"“Amontillado!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b082f4b5-39e4-4bef-be7e-77ca97f663f8","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“And I must satisfy them.”","summary":"","status":"written","orderKey":"zzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"891d1972-39f6-4cfe-9437-f75033e43710","type":"paragraph","text":"“And I must satisfy them.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"dc95e3de-6a64-4e19-9e10-2eba41f301a5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Amontillado!”","summary":"","status":"written","orderKey":"zzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"0149e1c1-209c-4cb7-9762-1b06f4875f43","type":"paragraph","text":"“Amontillado!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"8899cd4d-d88c-40b0-b7c4-12409ba608fb","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“As you are engaged, I am…","summary":"","status":"written","orderKey":"zzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"98f74fed-35e1-4305-a7d7-34f4f4045a91","type":"paragraph","text":"“As you are engaged, I am on my way to Luchesi. If any one has a critical turn, it is he. He will tell me—”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"3b8cdaf7-8ff8-4681-be77-a39a58ab4cfe","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Luchesi cannot tell Amontillado from Sherry.”","summary":"","status":"written","orderKey":"zzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"5ddc6393-5a46-4cfe-b52d-944adf006b20","type":"paragraph","text":"“Luchesi cannot tell Amontillado from Sherry.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"87fece74-8636-4053-8f33-d0e006c44e1e","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“And yet some fools will have…","summary":"","status":"written","orderKey":"zzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"0ea4f27b-6100-492e-92f3-8b696444a4e1","type":"paragraph","text":"“And yet some fools will have it that his taste is a match for your own.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"a9e3ed85-e820-4f4a-b1e0-467510058265","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Come, let us go.”","summary":"","status":"written","orderKey":"zzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f1f230a5-06a8-4d38-8f74-467a8fc5adc1","type":"paragraph","text":"“Come, let us go.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"1a978c3d-7de6-473d-8bf2-8a06a8328403","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Whither?”","summary":"","status":"written","orderKey":"zzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f33c42c0-7ea9-43ee-b120-830a36c50339","type":"paragraph","text":"“Whither?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"87aa1018-11cf-469f-a155-0ff23544aa6b","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“To your vaults.”","summary":"","status":"written","orderKey":"zzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"61efb26b-5215-43fc-a090-f2287cab739e","type":"paragraph","text":"“To your vaults.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b29c82c5-6c28-4049-b8d3-f79b255eb0e5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“My friend, no; I will not…","summary":"","status":"written","orderKey":"zzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"b3e17efd-232a-497f-a5df-a8088a2d4add","type":"paragraph","text":"“My friend, no; I will not impose upon your good nature. I perceive you have an engagement. Luchesi—”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"cf724c2d-2306-4ac7-bbe6-1130169448a5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“I have no engagement;—come.”","summary":"","status":"written","orderKey":"zzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"450fb9b4-3535-4976-8887-000448c08126","type":"paragraph","text":"“I have no engagement;—come.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"2c45f475-fe5c-4098-ae49-fec853ffb246","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“My friend, no. It is not…","summary":"","status":"written","orderKey":"zzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a1c01f6d-2cb6-410f-95b2-165ae0395f36","type":"paragraph","text":"“My friend, no. It is not the engagement, but the severe cold with which I perceive you are afflicted. The vaults are insufferably damp. They are encrusted with nitre.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0203088d-4021-4b5f-89d9-310023045e0e","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Let us go, nevertheless. The cold…","summary":"","status":"written","orderKey":"zzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"94807064-c18e-42f7-8358-75aa51185585","type":"paragraph","text":"“Let us go, nevertheless. The cold is merely nothing. Amontillado! You have been imposed upon. And as for Luchesi, he cannot distinguish Sherry from Amontillado.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"3e988b9e-5fe1-43b5-ad90-de64cbdee3ec","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"Thus speaking, Fortunato possessed himself of…","summary":"","status":"written","orderKey":"zzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"26453b64-0ec4-4d4b-ab57-9350cf77ac8e","type":"paragraph","text":"Thus speaking, Fortunato possessed himself of my arm. Putting on a mask of black silk, and drawing a _roquelaire_ closely about my person, I suffered him to hurry me to my palazzo.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f888ff34-7324-48ec-a267-55dc0724076a","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"There were no attendants at home;…","summary":"","status":"written","orderKey":"zzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"7a4a9244-5568-4dba-9c5b-f2dba5d856a8","type":"paragraph","text":"There were no attendants at home; they had absconded to make merry in honor of the time. I had told them that I should not return until the morning, and had given them explicit orders not to stir from the house. These orders were sufficient, I well knew, to insure their immediate disappearance, one and all, as soon as my back was turned.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"928af861-0c0b-41af-8257-3666688c7ce1","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"I took from their sconces two…","summary":"","status":"written","orderKey":"zzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"e2d8ca1c-6740-4f47-b9c2-01eb4475e01a","type":"paragraph","text":"I took from their sconces two flambeaux, and giving one to Fortunato, bowed him through several suites of rooms to the archway that led into the vaults. I passed down a long and winding staircase, requesting him to be cautious as he followed. We came at length to the foot of the descent, and stood together on the damp ground of the catacombs of the Montresors.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"e94e5dce-1315-48b7-8a04-be98d31a0f1a","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"The gait of my friend was…","summary":"","status":"written","orderKey":"zzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"75ca1edc-c4bb-452d-88e9-d5c5078f55a5","type":"paragraph","text":"The gait of my friend was unsteady, and the bells upon his cap jingled as he strode.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"5189de0f-5d75-4e47-a3ab-fc8d80ab3572","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“The pipe,” said he.","summary":"","status":"written","orderKey":"zzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"fc4c5cc4-07f4-4d8c-910c-c1daac45c5d3","type":"paragraph","text":"“The pipe,” said he.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"cadb81b2-3008-4147-936a-54a832b2cbc5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“It is farther on,” said I;…","summary":"","status":"written","orderKey":"zzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"54c0723b-86a9-4ace-bf61-4b3b8f2aba48","type":"paragraph","text":"“It is farther on,” said I; “but observe the white web-work which gleams from these cavern walls.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"83567fb7-4885-4918-b676-a92ff60d8629","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"He turned towards me, and looked…","summary":"","status":"written","orderKey":"zzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"e0af1be3-77ce-4629-9c8d-f1519d40be1f","type":"paragraph","text":"He turned towards me, and looked into my eyes with two filmy orbs that distilled the rheum of intoxication.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"07abf2c9-c3ff-4aa5-b1ee-7a4d5b4061f9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Nitre?” he asked, at length.","summary":"","status":"written","orderKey":"zzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a1fb8527-24ed-4a55-9415-491554a20d99","type":"paragraph","text":"“Nitre?” he asked, at length.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0f10f578-13bd-4ee9-a4bf-1716b07342bb","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Nitre,” I replied. “How long have…","summary":"","status":"written","orderKey":"zzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"3a267ea8-4d89-4aa2-89bf-0fc066229e64","type":"paragraph","text":"“Nitre,” I replied. “How long have you had that cough?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"63dfc802-8d15-4433-8767-eb3772fcce20","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Ugh! ugh! ugh!—ugh! ugh! ugh!—ugh! ugh!…","summary":"","status":"written","orderKey":"zzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"c137ed5a-2e94-4398-91eb-bd5f9edd874b","type":"paragraph","text":"“Ugh! ugh! ugh!—ugh! ugh! ugh!—ugh! ugh! ugh!—ugh! ugh! ugh!—ugh! ugh! ugh!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"2fcbc8f3-8908-4196-9383-8fef40673245","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"My poor friend found it impossible…","summary":"","status":"written","orderKey":"zzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"4ab6ec77-5299-44e7-a3a5-77d9ea0e8a7f","type":"paragraph","text":"My poor friend found it impossible to reply for many minutes.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"d2f03d45-3417-41f5-8c32-4a58c93fc958","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“It is nothing,” he said, at…","summary":"","status":"written","orderKey":"zzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a6bb4225-6502-4a39-a99f-8e37d31f0dd6","type":"paragraph","text":"“It is nothing,” he said, at last.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"3d3427c9-92ba-4fb7-9f29-2224cda1dd16","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Come,” I said, with decision, “we…","summary":"","status":"written","orderKey":"zzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"3a9af28c-9606-43cd-8428-7d20c771b633","type":"paragraph","text":"“Come,” I said, with decision, “we will go back; your health is precious. You are rich, respected, admired, beloved; you are happy, as once I was. You are a man to be missed. For me it is no matter. We will go back; you will be ill, and I cannot be responsible. Besides, there is Luchesi—”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"be2561b4-7ff4-432b-9e7f-3f1eab3b2cdf","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Enough,” he said; “the cough is…","summary":"","status":"written","orderKey":"zzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"785aeb7b-c81c-4deb-b431-874ecfa65cd9","type":"paragraph","text":"“Enough,” he said; “the cough is a mere nothing; it will not kill me. I shall not die of a cough.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"15f8d4d4-2011-43c8-b0b4-34494e968fc5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“True—true,” I replied; “and, indeed, I…","summary":"","status":"written","orderKey":"zzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a6c294c0-f9d7-4c6b-b303-e9b9096bfd3d","type":"paragraph","text":"“True—true,” I replied; “and, indeed, I had no intention of alarming you unnecessarily—but you should use all proper caution. A draught of this Medoc will defend us from the damps.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"e56c876b-cf27-410a-aaf0-df23c0d6f9bd","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"Here I knocked off the neck…","summary":"","status":"written","orderKey":"zzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"14b3c738-7092-4265-b51b-9e5b296a3f20","type":"paragraph","text":"Here I knocked off the neck of a bottle which I drew from a long row of its fellows that lay upon the mould.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"ace766b0-a578-402c-8321-df433c37dd39","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Drink,” I said, presenting him the…","summary":"","status":"written","orderKey":"zzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f6aeedd4-8557-4586-ac33-6b0f480930f3","type":"paragraph","text":"“Drink,” I said, presenting him the wine.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0a4cc19e-e3bd-42e2-a691-2da7b76cde9f","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"He raised it to his lips…","summary":"","status":"written","orderKey":"zzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"cd9febb5-ce24-4f9b-80e6-fc6c49ad3a91","type":"paragraph","text":"He raised it to his lips with a leer. He paused and nodded to me familiarly, while his bells jingled.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"34afc43b-5c49-49a9-a885-1e20ca835b75","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“I drink,” he said, “to the…","summary":"","status":"written","orderKey":"zzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"d9693006-c80d-4bbe-8460-35cdf93db915","type":"paragraph","text":"“I drink,” he said, “to the buried that repose around us.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"42187fe3-8e3d-4076-bd83-039a2470b2b6","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“And I to your long life.”","summary":"","status":"written","orderKey":"zzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"257a59ea-6823-484e-a084-60cc8059d01a","type":"paragraph","text":"“And I to your long life.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"cdb0c30d-c430-413a-bf9d-77422a75b0ee","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"He again took my arm, and…","summary":"","status":"written","orderKey":"zzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"07080d3f-b747-45e8-a255-fd2d9eefb011","type":"paragraph","text":"He again took my arm, and we proceeded.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c5170582-db40-44a0-bbb3-599812dafce9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“These vaults,” he said, “are extensive.”","summary":"","status":"written","orderKey":"zzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"15490ef2-6ca9-49d6-8e99-51084c62fb55","type":"paragraph","text":"“These vaults,” he said, “are extensive.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f3dd53b2-4aee-4e7f-91dc-b12f0ac8abce","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“The Montresors,” I replied, “were a…","summary":"","status":"written","orderKey":"zzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"ecf11aed-d6e7-49d7-adb5-4701e421b23a","type":"paragraph","text":"“The Montresors,” I replied, “were a great and numerous family.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"bff92144-c7a7-48bc-9846-205975064047","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“I forget your arms.”","summary":"","status":"written","orderKey":"zzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f862a3b8-3bb3-40eb-91f5-158011c843f7","type":"paragraph","text":"“I forget your arms.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"1987c407-8960-47b2-b462-bc7930c09398","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“A huge human foot d’or, in…","summary":"","status":"written","orderKey":"zzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9611142b-dad6-40de-9a9e-76c0b5cbfc46","type":"paragraph","text":"“A huge human foot d’or, in a field azure; the foot crushes a serpent rampant whose fangs are imbedded in the heel.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c839f6ba-ff2d-4400-8fe7-7d5ab0813410","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“And the motto?”","summary":"","status":"written","orderKey":"zzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"4f8418e8-767b-4efc-87bb-688c0a45f751","type":"paragraph","text":"“And the motto?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"2a228521-9405-45e6-833b-754d486f2d30","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“_Nemo me impune lacessit_.”","summary":"","status":"written","orderKey":"zzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f87515fb-8a0e-4b33-92f9-b30d46f24161","type":"paragraph","text":"“_Nemo me impune lacessit_.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"da4c7f3f-e733-4195-b6f4-a6623b286dad","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Good!” he said.","summary":"","status":"written","orderKey":"zzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"4cf75a50-265b-4ffd-abc5-19f08d2a07a9","type":"paragraph","text":"“Good!” he said.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"4c223645-a236-4feb-964f-6797a3af002e","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"The wine sparkled in his eyes…","summary":"","status":"written","orderKey":"zzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"36703545-1531-4a5a-bb5a-ebfd52c703ef","type":"paragraph","text":"The wine sparkled in his eyes and the bells jingled. My own fancy grew warm with the Medoc. We had passed through walls of piled bones, with casks and puncheons intermingling, into the inmost recesses of the catacombs. I paused again, and this time I made bold to seize Fortunato by an arm above the elbow.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"5897a251-5a9d-4222-81c5-e9d99f8ff1be","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“The nitre!” I said: “see, it…","summary":"","status":"written","orderKey":"zzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"711c7624-7d74-4399-9371-2ba98cc0e6e3","type":"paragraph","text":"“The nitre!” I said: “see, it increases. It hangs like moss upon the vaults. We are below the river’s bed. The drops of moisture trickle among the bones. Come, we will go back ere it is too late. Your cough—”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"04e8b3c1-ddc5-4c60-9db1-79a4c91c332f","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“It is nothing,” he said; “let…","summary":"","status":"written","orderKey":"zzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"58444cb4-dcef-4a25-b9d8-b52dfe537fa0","type":"paragraph","text":"“It is nothing,” he said; “let us go on. But first, another draught of the Medoc.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b727249e-e2cb-4725-ac53-265414e50b82","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"I broke and reached him a…","summary":"","status":"written","orderKey":"zzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"07c5fadf-2fbb-4b2c-a571-d96cb3e11f24","type":"paragraph","text":"I broke and reached him a flagon of De Grâve. He emptied it at a breath. His eyes flashed with a fierce light. He laughed and threw the bottle upwards with a gesticulation I did not understand.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"20797839-eb00-4774-b47a-18f3b937916c","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"I looked at him in surprise.…","summary":"","status":"written","orderKey":"zzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a614877c-68c6-4220-9533-31b878f9388e","type":"paragraph","text":"I looked at him in surprise. He repeated the movement—a grotesque one.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0289123c-d885-44a8-b862-a14d79c5e061","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“You do not comprehend?” he said.","summary":"","status":"written","orderKey":"zzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"48dfed23-78e6-4afa-af7c-3aafb3e77633","type":"paragraph","text":"“You do not comprehend?” he said.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"42a0ab96-2148-40fe-8c45-e47df305f3c9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Not I,” I replied.","summary":"","status":"written","orderKey":"zzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"7c26ae65-f5e4-4dc9-9586-f41a1c3d0fcd","type":"paragraph","text":"“Not I,” I replied.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"ec5ba7c7-af84-4831-908a-44876b5c056e","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Then you are not of the…","summary":"","status":"written","orderKey":"zzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"ce49791e-996f-4009-951b-3d26121093f2","type":"paragraph","text":"“Then you are not of the brotherhood.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f15c6801-9b9e-48b1-9b3f-e065abf82996","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“How?”","summary":"","status":"written","orderKey":"zzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f63e13c6-85fe-4ed9-8bd3-e97799086042","type":"paragraph","text":"“How?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"11eb34de-47d3-4cb7-af07-acce2d11055d","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“You are not of the masons.”","summary":"","status":"written","orderKey":"zzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8ba9de7c-12b9-47c2-a85a-bc4bd28b998e","type":"paragraph","text":"“You are not of the masons.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"dbb5d65c-f15a-4f0b-a3e6-0d50f5313b00","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Yes, yes,” I said, “yes, yes.”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9eb8230b-3674-41ae-b91f-1a06c6ff0e53","type":"paragraph","text":"“Yes, yes,” I said, “yes, yes.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"88b3ce0e-125d-41b3-a727-23d1316175ae","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“You? Impossible! A mason?”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"c9a47621-fa68-4317-9ce5-cfdceedb81f0","type":"paragraph","text":"“You? Impossible! A mason?”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"d121640f-9de0-4fe2-a22f-e5eef14ee889","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“A mason,” I replied.","summary":"","status":"written","orderKey":"zzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"129ba4cf-d150-48fb-8e99-3963e37f65f1","type":"paragraph","text":"“A mason,” I replied.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b1182f67-aa15-4ab4-a5ea-43fa9b466646","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“A sign,” he said.","summary":"","status":"written","orderKey":"zzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"e97b238c-9c7e-49d3-9583-3ce6c81a0dfa","type":"paragraph","text":"“A sign,” he said.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f8b2e2dd-77a3-4f8e-a9da-2b4e2ac8fa34","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“It is this,” I answered, producing…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"630ee5dd-5a16-4d3f-b440-b9a6630279dc","type":"paragraph","text":"“It is this,” I answered, producing a trowel from beneath the folds of my _roquelaire_.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"cc1956ab-2395-4605-b515-da2737fdf654","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“You jest,” he exclaimed, recoiling a…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"13a9db83-0b08-4aff-abf1-97e17cf23267","type":"paragraph","text":"“You jest,” he exclaimed, recoiling a few paces. “But let us proceed to the Amontillado.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"962f8e17-fe94-4176-a402-8ae60c71883d","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Be it so,” I said, replacing…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"2e963461-3d81-4bd4-9920-6cc8885ecb37","type":"paragraph","text":"“Be it so,” I said, replacing the tool beneath the cloak, and again offering him my arm. He leaned upon it heavily. We continued our route in search of the Amontillado. We passed through a range of low arches, descended, passed on, and descending again, arrived at a deep crypt, in which the foulness of the air caused our flambeaux rather to glow than flame.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"2d8e529d-9ae5-4848-83aa-15bbcb8f8ca1","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"At the most remote end of…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"36427d36-9e51-412f-b38f-59b6c301315b","type":"paragraph","text":"At the most remote end of the crypt there appeared another less spacious. Its walls had been lined with human remains, piled to the vault overhead, in the fashion of the great catacombs of Paris. Three sides of this interior crypt were still ornamented in this manner. From the fourth the bones had been thrown down, and lay promiscuously upon the earth, forming at one point a mound of some size. Within the wall thus exposed by the displacing of the bones, we perceived a still interior recess, in depth about four feet, in width three, in height six or seven. It seemed to have been constructed for no especial use in itself, but formed merely the interval between two of the colossal supports of the roof of the catacombs, and was backed by one of their circumscribing walls of solid granite.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"38052ff6-8afa-46db-beaf-982db4908eb6","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"It was in vain that Fortunato,…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"b4534f4f-2200-47e8-b572-642dd0a24567","type":"paragraph","text":"It was in vain that Fortunato, uplifting his dull torch, endeavored to pry into the depths of the recess. Its termination the feeble light did not enable us to see.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b6eae0e4-0df7-4861-ba20-a98d352ea967","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Proceed,” I said; “herein is the…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"73e62a77-ad08-4c1c-8c85-13075d01d24c","type":"paragraph","text":"“Proceed,” I said; “herein is the Amontillado. As for Luchesi—”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"014a2af5-9518-49da-8a52-1c23fa48f9d6","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“He is an ignoramus,” interrupted my…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"79476392-b169-4832-b855-caf9c3e6b012","type":"paragraph","text":"“He is an ignoramus,” interrupted my friend, as he stepped unsteadily forward, while I followed immediately at his heels. In an instant he had reached the extremity of the niche, and finding his progress arrested by the rock, stood stupidly bewildered. A moment more and I had fettered him to the granite. In its surface were two iron staples, distant from each other about two feet, horizontally. From one of these depended a short chain, from the other a padlock. Throwing the links about his waist, it was but the work of a few seconds to secure it. He was too much astounded to resist. Withdrawing the key I stepped back from the recess.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"4c01519f-98c5-4dae-9c24-7e1fd8389682","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Pass your hand,” I said, “over…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"a2070731-6c27-4fde-bf95-f9e0e6623eba","type":"paragraph","text":"“Pass your hand,” I said, “over the wall; you cannot help feeling the nitre. Indeed it is _very_ damp. Once more let me _implore_ you to return. No? Then I must positively leave you. But I must first render you all the little attentions in my power.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"d4722f88-96e2-49d7-941f-e5af18d87e4b","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“The Amontillado!” ejaculated my friend, not…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"aec73728-03a8-425a-b0be-ecc80522b412","type":"paragraph","text":"“The Amontillado!” ejaculated my friend, not yet recovered from his astonishment.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f3e544b7-eb95-4c56-bca1-8c40327452b8","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“True,” I replied; “the Amontillado.”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"eec52583-8002-4417-ac0b-8c9e7c0259a9","type":"paragraph","text":"“True,” I replied; “the Amontillado.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"1c1f9bf7-f66c-482e-add3-d8af4304bedb","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"As I said these words I…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"927cd95d-f49f-4a7d-b5a7-a8f29121402f","type":"paragraph","text":"As I said these words I busied myself among the pile of bones of which I have before spoken. Throwing them aside, I soon uncovered a quantity of building stone and mortar. With these materials and with the aid of my trowel, I began vigorously to wall up the entrance of the niche.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c87bd864-2506-44eb-8a6a-96f8ef319090","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"I had scarcely laid the first…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"28cec8ca-7567-4d8e-a5ae-66de5df73087","type":"paragraph","text":"I had scarcely laid the first tier of my masonry when I discovered that the intoxication of Fortunato had in a great measure worn off. The earliest indication I had of this was a low moaning cry from the depth of the recess. It was _not_ the cry of a drunken man. There was then a long and obstinate silence. I laid the second tier, and the third, and the fourth; and then I heard the furious vibrations of the chain. The noise lasted for several minutes, during which, that I might hearken to it with the more satisfaction, I ceased my labors and sat down upon the bones. When at last the clanking subsided, I resumed the trowel, and finished without interruption the fifth, the sixth, and the seventh tier. The wall was now nearly upon a level with my breast. I again paused, and holding the flambeaux over the mason-work, threw a few feeble rays upon the figure within.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"05589102-9983-4068-97c4-93d9a27528c5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"A succession of loud and shrill…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"48c93c67-ea11-47af-b211-bf27beec288c","type":"paragraph","text":"A succession of loud and shrill screams, bursting suddenly from the throat of the chained form, seemed to thrust me violently back. For a brief moment I hesitated—I trembled. Unsheathing my rapier, I began to grope with it about the recess; but the thought of an instant reassured me. I placed my hand upon the solid fabric of the catacombs, and felt satisfied. I reapproached the wall. I replied to the yells of him who clamored. I re-echoed—I aided—I surpassed them in volume and in strength. I did this, and the clamorer grew still.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f1c778f8-09bb-4a09-b778-b30d236e429f","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"It was now midnight, and my…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"00b6d9c5-4c37-47ef-834c-ad4f234a927c","type":"paragraph","text":"It was now midnight, and my task was drawing to a close. I had completed the eighth, the ninth, and the tenth tier. I had finished a portion of the last and the eleventh; there remained but a single stone to be fitted and plastered in. I struggled with its weight; I placed it partially in its destined position. But now there came from out the niche a low laugh that erected the hairs upon my head. It was succeeded by a sad voice, which I had difficulty in recognising as that of the noble Fortunato. The voice said—","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"428f917f-db12-4ee0-b878-0cdf1ae40ff9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Ha! ha! ha!—he! he!—a very good…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"b30da9b1-3f6a-492e-af57-637e30ec8597","type":"paragraph","text":"“Ha! ha! ha!—he! he!—a very good joke indeed—an excellent jest. We will have many a rich laugh about it at the palazzo—he! he! he!—over our wine—he! he! he!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"34544da5-feff-45a0-b516-ecd1a3f605ba","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“The Amontillado!” I said.","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"e47df052-4413-4a9b-af33-a6211e08b42c","type":"paragraph","text":"“The Amontillado!” I said.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"28bd676a-d853-494c-b46d-9f91764dd2e1","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“He! he! he!—he! he! he!—yes, the…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"2b3c51c7-974f-4ac4-82ab-d7c2889f333e","type":"paragraph","text":"“He! he! he!—he! he! he!—yes, the Amontillado. But is it not getting late? Will not they be awaiting us at the palazzo, the Lady Fortunato and the rest? Let us be gone.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"35190817-b1c6-4171-842c-da4697c97038","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Yes,” I said, “let us be…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"64e6b41c-b11f-4f92-b2fd-49a074bc55ef","type":"paragraph","text":"“Yes,” I said, “let us be gone.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"6f9129e2-4d69-416c-8e69-630ea6c248e6","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“_For the love of God, Montressor!_”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"c5545141-4112-422b-8804-b39b1fe61d5b","type":"paragraph","text":"“_For the love of God, Montressor!_”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c5dc2f77-0ba9-4ff6-a31d-b11f911922d9","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Yes,” I said, “for the love…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8fc2abc5-0910-4f62-933c-10c16c4b2b32","type":"paragraph","text":"“Yes,” I said, “for the love of God!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"d3c3647c-d082-4194-9be4-23575c2bf31d","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"But to these words I hearkened…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"19b4f6cd-ff63-4460-828b-9a41566601d5","type":"paragraph","text":"But to these words I hearkened in vain for a reply. I grew impatient. I called aloud—","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0565bd17-21b7-4dcd-8df3-c57bca851d2a","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Fortunato!”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"44621cf2-dc5f-4b66-9d05-c4376ca1aefb","type":"paragraph","text":"“Fortunato!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"8f215b9a-922b-4f46-a9f2-251f156a8270","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"No answer. I called again—","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9e619ef5-e8dc-4fdb-ac7c-964e301795bf","type":"paragraph","text":"No answer. I called again—","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"6bc6f577-1f79-4fd1-8a3c-cee33ffce9df","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"“Fortunato!”","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"92db30ac-5ca0-4998-8bad-3faa3ad9801c","type":"paragraph","text":"“Fortunato!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"15658647-867c-4deb-8867-b0ca42adb458","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","title":"No answer still. I thrust a…","summary":"","status":"written","orderKey":"zzzzzzzzzzzzzzzzzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"6fbdb979-6f6f-4b73-98ca-1f9dad4d12d1","type":"paragraph","text":"No answer still. I thrust a torch through the remaining aperture and let it fall within. There came forth in return only a jingling of the bells. My heart grew sick—on account of the dampness of the catacombs. I hastened to make an end of my labor. I forced the last stone into its position; I plastered it up. Against the new masonry I re-erected the old rampart of bones. For the half of a century no mortal has disturbed them. _In pace requiescat!_","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"b880bb51-8314-4163-9d78-15e7d5be3a05","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"The “Red Death” had long devastated…","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f0ccf6c4-7b7d-4584-85f0-816f63053de7","type":"paragraph","text":"The “Red Death” had long devastated the country. No pestilence had ever been so fatal, or so hideous. Blood was its Avatar and its seal—the redness and the horror of blood. There were sharp pains, and sudden dizziness, and then profuse bleeding at the pores, with dissolution. The scarlet stains upon the body and especially upon the face of the victim, were the pest ban which shut him out from the aid and from the sympathy of his fellow-men. And the whole seizure, progress and termination of the disease, were the incidents of half an hour.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"bd509a4e-56d5-4d57-a18a-3fe2bfe4e039","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"But the Prince Prospero was happy…","summary":"","status":"written","orderKey":"l","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8ab5d09c-3d80-4f77-87df-c10d2b6206e1","type":"paragraph","text":"But the Prince Prospero was happy and dauntless and sagacious. When his dominions were half depopulated, he summoned to his presence a thousand hale and light-hearted friends from among the knights and dames of his court, and with these retired to the deep seclusion of one of his castellated abbeys. This was an extensive and magnificent structure, the creation of the prince’s own eccentric yet august taste. A strong and lofty wall girdled it in. This wall had gates of iron. The courtiers, having entered, brought furnaces and massy hammers and welded the bolts. They resolved to leave means neither of ingress or egress to the sudden impulses of despair or of frenzy from within. The abbey was amply provisioned. With such precautions the courtiers might bid defiance to contagion. The external world could take care of itself. In the meantime it was folly to grieve, or to think. The prince had provided all the appliances of pleasure. There were buffoons, there were improvisatori, there were ballet-dancers, there were musicians, there was Beauty, there was wine. All these and security were within. Without was the “Red Death.”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c31dbe9d-a1dd-4681-8a80-42d3a4854b36","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"It was toward the close of…","summary":"","status":"written","orderKey":"t","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"ee6512a7-d272-4bb7-9946-13cb40e70a6c","type":"paragraph","text":"It was toward the close of the fifth or sixth month of his seclusion, and while the pestilence raged most furiously abroad, that the Prince Prospero entertained his thousand friends at a masked ball of the most unusual magnificence.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0ccc7219-ff85-4241-8fa8-c44277cd48d5","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"It was a voluptuous scene, that…","summary":"","status":"written","orderKey":"x","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"2b87a471-1e39-45b7-9480-74900be6b45b","type":"paragraph","text":"It was a voluptuous scene, that masquerade. But first let me tell of the rooms in which it was held. There were seven—an imperial suite. In many palaces, however, such suites form a long and straight vista, while the folding doors slide back nearly to the walls on either hand, so that the view of the whole extent is scarcely impeded. Here the case was very different; as might have been expected from the duke’s love of the bizarre. The apartments were so irregularly disposed that the vision embraced but little more than one at a time. There was a sharp turn at every twenty or thirty yards, and at each turn a novel effect. To the right and left, in the middle of each wall, a tall and narrow Gothic window looked out upon a closed corridor which pursued the windings of the suite. These windows were of stained glass whose color varied in accordance with the prevailing hue of the decorations of the chamber into which it opened. That at the eastern extremity was hung, for example, in blue—and vividly blue were its windows. The second chamber was purple in its ornaments and tapestries, and here the panes were purple. The third was green throughout, and so were the casements. The fourth was furnished and lighted with orange—the fifth with white—the sixth with violet. The seventh apartment was closely shrouded in black velvet tapestries that hung all over the ceiling and down the walls, falling in heavy folds upon a carpet of the same material and hue. But in this chamber only, the color of the windows failed to correspond with the decorations. The panes here were scarlet—a deep blood color. Now in no one of the seven apartments was there any lamp or candelabrum, amid the profusion of golden ornaments that lay scattered to and fro or depended from the roof. There was no light of any kind emanating from lamp or candle within the suite of chambers. But in the corridors that followed the suite, there stood, opposite to each window, a heavy tripod, bearing a brazier of fire that projected its rays through the tinted glass and so glaringly illumined the room. And thus were produced a multitude of gaudy and fantastic appearances. But in the western or black chamber the effect of the fire-light that streamed upon the dark hangings through the blood-tinted panes, was ghastly in the extreme, and produced so wild a look upon the countenances of those who entered, that there were few of the company bold enough to set foot within its precincts at all.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"a48b2f3b-a9e0-4c43-b532-21fd20a064ea","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"It was in this apartment, also,…","summary":"","status":"written","orderKey":"z","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"01aedf33-ca6f-47fb-a37a-ccf504d74d18","type":"paragraph","text":"It was in this apartment, also, that there stood against the western wall, a gigantic clock of ebony. Its pendulum swung to and fro with a dull, heavy, monotonous clang; and when the minute-hand made the circuit of the face, and the hour was to be stricken, there came from the brazen lungs of the clock a sound which was clear and loud and deep and exceedingly musical, but of so peculiar a note and emphasis that, at each lapse of an hour, the musicians of the orchestra were constrained to pause, momentarily, in their performance, to hearken to the sound; and thus the waltzers perforce ceased their evolutions; and there was a brief disconcert of the whole gay company; and, while the chimes of the clock yet rang, it was observed that the giddiest grew pale, and the more aged and sedate passed their hands over their brows as if in confused reverie or meditation. But when the echoes had fully ceased, a light laughter at once pervaded the assembly; the musicians looked at each other and smiled as if at their own nervousness and folly, and made whispering vows, each to the other, that the next chiming of the clock should produce in them no similar emotion; and then, after the lapse of sixty minutes (which embrace three thousand and six hundred seconds of the Time that flies), there came yet another chiming of the clock, and then were the same disconcert and tremulousness and meditation as before.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"21f75be1-1795-492a-bca6-d86205bf0fd4","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"But, in spite of these things,…","summary":"","status":"written","orderKey":"zV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"74b8a4f1-3da7-4ba5-ac84-73ad665bf806","type":"paragraph","text":"But, in spite of these things, it was a gay and magnificent revel. The tastes of the duke were peculiar. He had a fine eye for colors and effects. He disregarded the decora of mere fashion. His plans were bold and fiery, and his conceptions glowed with barbaric lustre. There are some who would have thought him mad. His followers felt that he was not. It was necessary to hear and see and touch him to be sure that he was not.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"a4165c37-913f-4c76-aba1-edfb88b5d206","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"He had directed, in great part,…","summary":"","status":"written","orderKey":"zl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"2eeea707-4426-4619-b357-9cef13d027d6","type":"paragraph","text":"He had directed, in great part, the moveable embellishments of the seven chambers, upon occasion of this great fête; and it was his own guiding taste which had given character to the masqueraders. Be sure they were grotesque. There were much glare and glitter and piquancy and phantasm—much of what has been since seen in “Hernani.” There were arabesque figures with unsuited limbs and appointments. There were delirious fancies such as the madman fashions. There was much of the beautiful, much of the wanton, much of the bizarre, something of the terrible, and not a little of that which might have excited disgust. To and fro in the seven chambers there stalked, in fact, a multitude of dreams. And these—the dreams—writhed in and about, taking hue from the rooms, and causing the wild music of the orchestra to seem as the echo of their steps. And, anon, there strikes the ebony clock which stands in the hall of the velvet. And then, for a moment, all is still, and all is silent save the voice of the clock. The dreams are stiff-frozen as they stand. But the echoes of the chime die away—they have endured but an instant—and a light, half-subdued laughter floats after them as they depart. And now again the music swells, and the dreams live, and writhe to and fro more merrily than ever, taking hue from the many-tinted windows through which stream the rays from the tripods. But to the chamber which lies most westwardly of the seven, there are now none of the maskers who venture; for the night is waning away; and there flows a ruddier light through the blood-colored panes; and the blackness of the sable drapery appals; and to him whose foot falls upon the sable carpet, there comes from the near clock of ebony a muffled peal more solemnly emphatic than any which reaches their ears who indulge in the more remote gaieties of the other apartments.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"8e28f8fd-99ab-42e5-a059-732642e4e246","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"But these other apartments were densely…","summary":"","status":"written","orderKey":"zt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"b98614b7-bc9b-4055-af5c-3a901a81e90a","type":"paragraph","text":"But these other apartments were densely crowded, and in them beat feverishly the heart of life. And the revel went whirlingly on, until at length there commenced the sounding of midnight upon the clock. And then the music ceased, as I have told; and the evolutions of the waltzers were quieted; and there was an uneasy cessation of all things as before. But now there were twelve strokes to be sounded by the bell of the clock; and thus it happened, perhaps, that more of thought crept, with more of time, into the meditations of the thoughtful among those who revelled. And thus, too, it happened, perhaps, that before the last echoes of the last chime had utterly sunk into silence, there were many individuals in the crowd who had found leisure to become aware of the presence of a masked figure which had arrested the attention of no single individual before. And the rumor of this new presence having spread itself whisperingly around, there arose at length from the whole company a buzz, or murmur, expressive of disapprobation and surprise—then, finally, of terror, of horror, and of disgust.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c6fa5374-13bc-4f76-8acc-b789a0976925","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"In an assembly of phantasms such…","summary":"","status":"written","orderKey":"zx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"efa77fc0-e697-48b4-bbaf-8ba56fe5ce30","type":"paragraph","text":"In an assembly of phantasms such as I have painted, it may well be supposed that no ordinary appearance could have excited such sensation. In truth the masquerade license of the night was nearly unlimited; but the figure in question had out-Heroded Herod, and gone beyond the bounds of even the prince’s indefinite decorum. There are chords in the hearts of the most reckless which cannot be touched without emotion. Even with the utterly lost, to whom life and death are equally jests, there are matters of which no jest can be made. The whole company, indeed, seemed now deeply to feel that in the costume and bearing of the stranger neither wit nor propriety existed. The figure was tall and gaunt, and shrouded from head to foot in the habiliments of the grave. The mask which concealed the visage was made so nearly to resemble the countenance of a stiffened corpse that the closest scrutiny must have had difficulty in detecting the cheat. And yet all this might have been endured, if not approved, by the mad revellers around. But the mummer had gone so far as to assume the type of the Red Death. His vesture was dabbled in blood—and his broad brow, with all the features of the face, was besprinkled with the scarlet horror.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"1dc44a38-cea4-4a5b-b548-f4b4df032661","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"When the eyes of Prince Prospero…","summary":"","status":"written","orderKey":"zz","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"c470d04e-3790-4e9e-ae2b-36dfbfcc6f95","type":"paragraph","text":"When the eyes of Prince Prospero fell upon this spectral image (which with a slow and solemn movement, as if more fully to sustain its role, stalked to and fro among the waltzers) he was seen to be convulsed, in the first moment with a strong shudder either of terror or distaste; but, in the next, his brow reddened with rage.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"c6353520-80b8-4ad1-bb91-fb372360cafb","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"“Who dares?” he demanded hoarsely of…","summary":"","status":"written","orderKey":"zzV","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"bd4a0ecb-abcf-4d9d-b0a4-042f013ecfbe","type":"paragraph","text":"“Who dares?” he demanded hoarsely of the courtiers who stood near him—“who dares insult us with this blasphemous mockery? Seize him and unmask him—that we may know whom we have to hang at sunrise, from the battlements!”","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"0ca3346d-d7d1-4d5b-834c-c14de7b419f3","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"It was in the eastern or…","summary":"","status":"written","orderKey":"zzl","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"fb756f63-56be-4c2b-bbd9-5eeaa05685c8","type":"paragraph","text":"It was in the eastern or blue chamber in which stood the Prince Prospero as he uttered these words. They rang throughout the seven rooms loudly and clearly—for the prince was a bold and robust man, and the music had become hushed at the waving of his hand.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"4a1a14a6-45d9-40e7-8a76-88d510e507d2","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"It was in the blue room…","summary":"","status":"written","orderKey":"zzt","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8581c174-768b-4124-937c-80110c247cfc","type":"paragraph","text":"It was in the blue room where stood the prince, with a group of pale courtiers by his side. At first, as he spoke, there was a slight rushing movement of this group in the direction of the intruder, who at the moment was also near at hand, and now, with deliberate and stately step, made closer approach to the speaker. But from a certain nameless awe with which the mad assumptions of the mummer had inspired the whole party, there were found none who put forth hand to seize him; so that, unimpeded, he passed within a yard of the prince’s person; and, while the vast assembly, as if with one impulse, shrank from the centres of the rooms to the walls, he made his way uninterruptedly, but with the same solemn and measured step which had distinguished him from the first, through the blue chamber to the purple—through the purple to the green—through the green to the orange—through this again to the white—and even thence to the violet, ere a decided movement had been made to arrest him. It was then, however, that the Prince Prospero, maddening with rage and the shame of his own momentary cowardice, rushed hurriedly through the six chambers, while none followed him on account of a deadly terror that had seized upon all. He bore aloft a drawn dagger, and had approached, in rapid impetuosity, to within three or four feet of the retreating figure, when the latter, having attained the extremity of the velvet apartment, turned suddenly and confronted his pursuer. There was a sharp cry—and the dagger dropped gleaming upon the sable carpet, upon which, instantly afterwards, fell prostrate in death the Prince Prospero. Then, summoning the wild courage of despair, a throng of the revellers at once threw themselves into the black apartment, and, seizing the mummer, whose tall figure stood erect and motionless within the shadow of the ebony clock, gasped in unutterable horror at finding the grave-cerements and corpse-like mask which they handled with so violent a rudeness, untenanted by any tangible form.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"24ae1f11-5767-4c41-adf9-909eb78e31cc","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","title":"And now was acknowledged the presence…","summary":"","status":"written","orderKey":"zzx","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"07502969-2824-452b-9010-897a47559ddd","type":"paragraph","text":"And now was acknowledged the presence of the Red Death. He had come like a thief in the night. And one by one dropped the revellers in the blood-bedewed halls of their revel, and died each in the despairing posture of his fall. And the life of the ebony clock went out with that of the last of the gay. And the flames of the tripods expired. And Darkness and Decay and the Red Death held illimitable dominion over all.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"}],"markers":[{"id":"5ba15a3d-85de-4be2-94ff-ca298929c655","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"ba9753a5-2998-46ad-998c-08dc0da669b1","kind":"chapter","title":"The Tell-Tale Heart","notes":"","page":{"include":false,"opensRecto":null,"sheetBefore":null,"showNumber":true,"showTitle":true,"epigraph":"","summary":"","suggestedSummary":"","suggestedAt":null,"template":"book","layout":null,"rule":null,"dropInches":null,"openingLines":null,"blankBefore":false,"backBlank":false,"assetId":null,"graphicWidth":40,"image":null,"align":"center"},"cast":[],"titlePage":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"e0b55f61-af8a-44f3-9dcb-79dceeadbca0","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"e763638a-8e52-4af8-9b77-3f0e5d416bf8","kind":"chapter","title":"The Cask of Amontillado","notes":"","page":{"include":false,"opensRecto":null,"sheetBefore":null,"showNumber":true,"showTitle":true,"epigraph":"","summary":"","suggestedSummary":"","suggestedAt":null,"template":"book","layout":null,"rule":null,"dropInches":null,"openingLines":null,"blankBefore":false,"backBlank":false,"assetId":null,"graphicWidth":40,"image":null,"align":"center"},"cast":[],"titlePage":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"},{"id":"f23d1452-a2ca-4d66-896d-1d4668565a84","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","unitId":"da3adab4-b79b-463f-846d-44925a287cfc","kind":"chapter","title":"The Masque of the Red Death","notes":"","page":{"include":false,"opensRecto":null,"sheetBefore":null,"showNumber":true,"showTitle":true,"epigraph":"","summary":"","suggestedSummary":"","suggestedAt":null,"template":"book","layout":null,"rule":null,"dropInches":null,"openingLines":null,"blankBefore":false,"backBlank":false,"assetId":null,"graphicWidth":40,"image":null,"align":"center"},"cast":[],"titlePage":null,"createdAt":"2026-11-12T04:52:00.312Z","updatedAt":"2026-11-12T04:52:00.312Z"}],"assets":[],"boards":[],"documents":[],"extractPalettes":[],"extractCategories":[],"extracts":[],"outlines":[{"id":"59de8787-e1b1-492f-91cf-295c80f1d348","projectId":"91366f2b-1226-4a73-a01a-5bde1d7868ce","name":"Outline","items":[{"id":"1f76eb59-ad2a-4692-acee-7c7f6a5bfce0","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":null,"orderKey":"V","kind":"chapter","title":"The Tell-Tale Heart","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"f9e35921-0ba4-48a2-b155-06795a246a0a","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"1f76eb59-ad2a-4692-acee-7c7f6a5bfce0","orderKey":"V","kind":"scene","title":"Not mad","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"136fa391-3e3b-49af-b609-199166d22c4e","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"f9e35921-0ba4-48a2-b155-06795a246a0a","orderKey":"V","kind":"beat","title":"The eye of a vulture","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"984c75c2-2c43-45cf-b139-5c757c991fe2","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"1f76eb59-ad2a-4692-acee-7c7f6a5bfce0","orderKey":"l","kind":"scene","title":"Eight nights at the door","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"fee12fe6-6aea-4bfe-b4dd-8932811e6e5c","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"984c75c2-2c43-45cf-b139-5c757c991fe2","orderKey":"V","kind":"beat","title":"The lantern, the single ray","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52: