9a721b30-cd3e-4673-8a2c-e61f4713e672","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"56e680b8-0b07-40b1-8059-20615a892bd9","orderKey":"V","kind":"beat","title":"Carnival, and Fortunato in motley","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"7769882c-0fe9-4cfc-a104-66a3a7475caf","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"f65f0d29-ae52-4776-8802-1fd473e58f04","orderKey":"l","kind":"scene","title":"Into the vaults","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.322Z","updatedAt":"2026-11-12T04:52:00.322Z"},{"id":"409fb986-5cda-42e8-b1a2-677b322724f3","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"7769882c-0fe9-4cfc-a104-66a3a7475caf","orderKey":"V","kind":"beat","title":"The nitre, and the cough","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.323Z","updatedAt":"2026-11-12T04:52:00.323Z"},{"id":"9ec1f72f-3a39-47f2-bd8c-07153737872c","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":"7769882c-0fe9-4cfc-a104-66a3a7475caf","orderKey":"l","kind":"beat","title":"The last tier of stone","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.323Z","updatedAt":"2026-11-12T04:52:00.323Z"},{"id":"f38c6cd0-e855-461e-bf1e-9a5276d39457","outlineId":"59de8787-e1b1-492f-91cf-295c80f1d348","parentId":null,"orderKey":"t","kind":"chapter","title":"The Masque of the Red Death","body":"","status":"","collapsed":false,"boundUnitId":null,"boundBeatId":null,"boundMarkerId":null,"source":null,"createdAt":"2026-11-12T04:52:00.323Z","updatedAt":"2026-11-12T04:52:00.323Z"},{"id":"90a3cea7-68a5-4859-