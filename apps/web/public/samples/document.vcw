{"formatVersion":3,"generator":"vcwriter","savedAt":"2026-11-12T04:52:00.324Z","project":{"id":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","ownerId":null,"format":"document","title":"Heron Window Proposal","author":"A. Writer","logline":"","elevatorPitch":"","synopsis":"","genre":"","notes":"","status":"development","posterAssetId":null,"lastOpenedAt":null,"mooring":null,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.326Z"},"settings":{"narratorVoice":null,"autosaveIntervalMs":5000,"snapshotEveryNSaves":20,"includeBeatTitlesInExport":false,"focusMode":false,"markerNumbering":"","markerSymbol":"❦","sectionNumbering":"decimal","outlineCase":"as_typed","includeChapterPagesInExport":true,"paragraphStyle":"indented","scriptFormat":"us","formatOverrides":{"templateName":"","elements":{}},"actBreaks":false,"maxSeconds":0,"episodeCarry":{},"editorIgnoredRules":[],"editorAllowedWords":[],"storyGrid":{},"titlePage":{"title":"","titleImage":"","episode":"","descriptor":"","byline":"","credits":[],"author":"","source":"","sourceAuthor":"","contact":"","draftDate":"","revision":"","notes":""},"castPage":{"heading":"","order":"appearance","time":"","place":"","notes":""},"chapterPageStyle":{},"book":{},"citations":{}},"tracks":[{"id":"754cc8c7-f210-4cb9-96e7-8de7dd666e30","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Main Plot","kind":"main_plot","color":"#c9a45c","description":"","arc":"","orderKey":"V","collapsed":false,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"}],"units":[{"id":"48f54102-0885-4df7-954a-9c18e229ef6e","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","trackId":"754cc8c7-f210-4cb9-96e7-8de7dd666e30","kind":"scene","title":"Opening Scene","sequenceLabel":"Sc. 1","summary":"","notes":"","status":"outline","orderKey":"V","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"}],"beats":[{"id":"ebea7a62-f93a-45d7-b501-3cdfeba78a45","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","unitId":"48f54102-0885-4df7-954a-9c18e229ef6e","title":"Opening beat","summary":"","status":"planned","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"}],"markers":[],"assets":[],"boards":[],"documents":[{"id":"5e116df1-7816-4a60-9a90-aa43b31eea2a","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","title":"Heron Window Proposal","content":{"type":"doc","content":[{"type":"heading","content":[{"type":"text","text":"Marsh End Heritage Trust"}],"attrs":{"level":1}},{"type":"paragraph"},{"type":"heading","content":[{"type":"text","text":"Proposal: Restoring the Heron Window"}],"attrs":{"level":2}},{"type":"paragraph"},{"type":"heading","content":[{"type":"text","text":"Summary"}],"attrs":{"level":3}},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","text":"The Heron Window in St Bride's has stood in the north aisle since 1891. Water damage over the last decade has loosened the lead and cracked four panels. This proposal sets out the work needed, its cost, and a timetable that completes the restoration before the church's 150th anniversary."}]},{"type":"paragraph"},{"type":"heading","content":[{"type":"text","text":"Background"}],"attrs":{"level":3}},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","text":"The window was made by a local glassblower and shows a heron standing in reeds, the emblem the town has used on its seal ever since. It is the only surviving work of its maker and is listed in the county's record of historic glass."}]},{"type":"paragraph"},{"type":"heading","content":[{"type":"text","text":"The work"}],"attrs":{"level":3}},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","text":"A specialist conservator will remove the window in sections, clean and re-lead each panel, replace the four cracked pieces with matched glass, and fit protective outer glazing."}]},{"type":"paragraph"},{"type":"heading","content":[{"type":"text","text":"Timetable and cost"}],"attrs":{"level":3}},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","text":"Removal and survey in May; conservation through the summer; reinstallation in September. The total estimated cost is £18,400, of which the Trust has already raised £11,000."}]}]},"schemaVersion":1,"pageSetup":{"paper":"letter","orientation":"portrait","margins":{"top":1,"right":1,"bottom":1,"left":1}},"revision":1,"outlineId":null,"outlineLinks":[],"headingNumbering":"none","rowReceipts":[],"headerFooter":{"header":{"left":"","center":"","right":""},"footer":{"left":"","center":"","right":""},"firstPage":true},"comments":[],"trackChanges":false,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.325Z"}],"extractPalettes":[],"extractCategories":[],"extracts":[],"outlines":[],"researchCategories":[{"id":"4c3c6807-9cd3-4aec-9728-aa7a8c61fc96","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Characters","systemKey":"characters","description":"","parentId":null,"color":null,"sessionId":null,"orderKey":"V","archived":false,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"},{"id":"3262ddbb-8189-4783-8f38-408eaebcde50","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Ideas","systemKey":"ideas","description":"","parentId":null,"color":null,"sessionId":null,"orderKey":"l","archived":false,"createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"},{"id":"1f98e8b7-c7d9-41c6-a0f6-cd9f804eeef0","projectId"