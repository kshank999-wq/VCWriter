-408eaebcde50","title":"Window history","body":"Made 1891 by the town glassblower. Listed in the county record of historic glass.","tags":[],"source":"","comment":"","rewrite":"","sourceId":null,"sourceFrom":null,"sourceTo":null,"alsoIn":[],"place":null,"usage":"unused","usedAt":null,"usedInBeatIds":[],"usedConfirmed":false,"archived":false,"orderKey":"V","origin":"desktop","captureCategory":null,"capturedAt":null,"author":null,"createdAt":"2026-11-12T04:52:00.326Z","updatedAt":"2026-11-12T04:52:00.326Z"}],"noteSessions":[],"noteSources":[],"characters":[],"characterCategories":[{"id":"b4d4b1ef-3821-424c-9456-702bec57e6ef","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Main character","orderKey":"V","createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"},{"id":"b914e1d4-fddc-40e8-a8ac-6e67542ca9e7","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Minor character","orderKey":"l","createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"},{"id":"72eeb888-c916-489e-928b-ba5399113c6f","projectId":"43e12059-64cc-4aa9-ab1f-df12f2249a4a","name":"Extra","orderKey":"t","createdAt":"2026-11-12T04:52:00.324Z","updatedAt":"2026-11-12T04:52:00.324Z"}],"characterTraits":[],"characterizationItems":[],"usageLinks":[],"themes":[],"motifs":[],"themeMotifLinks":[],"locations":[],"characterArcs":[],"arcPoints":[],"characterRelationships":[],"indexMarks":[],"indexRefs":[],"references":[],"citations":[],"links":[],"threads":[],"narrativeElements":[],"choices":[],"stateDefinitions":[],"resourceDefinitions":[],"simulationRuns":[],"gameSetup":null,"learningAids":[],"importBatches":[],"setupsPayoffs":[],"snapshots":[],"sessions":[]}
