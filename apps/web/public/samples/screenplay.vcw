tes":"","status":"draft_complete","orderKey":"x","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"Helpless / in control","polarity":"up","polarityStart":"negative","polarityEnd":"positive","purposes":[],"otherPurpose":"","turn":"Ben takes charge and boards up the house","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.281Z"},{"id":"61747ebb-25ca-47db-96be-3e3290a37b4c","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","trackId":"52ce4ebe-2f78-420f-94c6-47ef101489b6","kind":"scene","title":"INT. FARMHOUSE - LIVING ROOM - LATER","sequenceLabel":"Sc. 5","summary":"","notes":"","status":"draft_complete","orderKey":"z","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"Hope / despair","polarity":"down","polarityStart":"positive","polarityEnd":"double_negative","purposes":[],"otherPurpose":"","turn":"The radio: the dead are walking","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.281Z"},{"id":"b7b839f7-00ee-49f0-a254-a09c6c102391","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","trackId":"52ce4ebe-2f78-420f-94c6-47ef101489b6","kind":"scene","title":"EXT. OPEN FIELD - DAY (NEWS FOOTAGE)","sequenceLabel":"Sc. 6","summary":"","notes":"","status":"draft_complete","orderKey":"zV","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"Despair / hope","polarity":"up","polarityStart":"negative","polarityEnd":"positive","purposes":[],"otherPurpose":"","turn":"They can be stopped","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.281Z"},{"id":"ba57082f-5956-4c2e-a0ad-5f15ccb86096","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","trackId":"52ce4ebe-2f78-420f-94c6-47ef101489b6","kind":"scene","title":"INT. FARMHOUSE - CELLAR DOOR - NIGHT","sequenceLabel":"Sc. 7","summary":"","notes":"","status":"draft_complete","orderKey":"zl","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"Trust / conflict","polarity":"down","polarityStart":"positive","polarityEnd":"negative","purposes":[],"otherPurpose":"","turn":"Harry has been hiding in the cellar all along","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.281Z"}],"beats":[{"id":"76f8380a-4e27-4d66-b5a8-f2e5d8833df1","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"77801ace-f9c9-4de1-8c71-a7c7d7a99c14","title":"The drive out","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9db0e3a4-9088-4d78-a1e0-53843d08be2e","type":"scene_heading","text":"EXT. COUNTRY ROAD - DUSK","characterId":null,"attributes":{}},{"id":"d03e49ab-d2af-4206-8e89-f898b6e92818","type":"action","text":"A car winds along an empty road through the Pennsylvania hills. Late afternoon light. Inside, JOHNNY (20s) drives; his sister BARBRA (20s) sits beside him.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"8bd6a39a-618b-4e87-ac67-f24df3a1c240","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"18096261-37ba-41a4-bb63-cce92558a27c","title":"They're coming to get you, Barbra","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"4822a34e-0cc4-451a-8134-4072b3b4ec9a","type":"scene_heading","text":"EXT. CEMETERY - DUSK","characterId":null,"attributes":{}},{"id":"cc2550d8-ce05-451a-8d7d-04de1c6dc586","type":"action","text":"The car pulls up at the gates of a hillside cemetery. Wind in the trees. Johnny and Barbra walk between the graves carrying a small wreath.","characterId":null,"attributes":{}},{"id":"e0d0f280-8c4d-4072-9407-81956fe507c9","type":"action","text":"They kneel at their father's grave. Barbra bows her head. Johnny fidgets.","characterId":null,"attributes":{}},{"id":"8af12bf9-0d1b-4bf8-bc17-c3cfe90a86de","type":"action","text":"Across the cemetery, a lone MAN in a dark suit walks slowly between the stones.","characterId":null,"attributes":{}},{"id":"a6ce3f41-85b1-4037-967a-e1f0ac153cac","type":"character","text":"JOHNNY","characterId":"ad6dc0c1-9632-4b30-8eaf-df56f7aad34f","attributes":{}},{"id":"51315b91-82f5-4bf1-a91b-e63944817be2","type":"dialogue","text":"They're coming to get you, Barbra.","characterId":null,"attributes":{}},{"id":"1318a6a3-d445-4d50-bdec-cded0af99739","type":"character","text":"BARBRA","characterId":"01ea36c3-bb48-4817-b705-eae399fa26f3","attributes":{}},{"id":"86f7a22a-d2c2-4fa0-b51b-78872819280e","type":"dialogue","text":"Stop it. You're ignorant.","characterId":null,"attributes":{}},{"id":"2748d887-a497-4c81-a5c1-932b55b082da","type":"character","text":"JOHNNY","characterId":"ad6dc0c1-9632-4b30-8eaf-df56f7aad34f","attributes":{}},{"id":"2ab2d91e-2162-4b90-89bd-58fe7bb352e5","type":"parenthetical","text":"(pointing at the man, in a ghoul's voice)","characterId":null,"attributes":{}},{"id":"949a7c1f-afea-47cf-98d1-540ddfb17a9d","type":"dialogue","text":"They're coming for you, Barbra. Look! There comes one of them now!","characterId":null,"attributes":{}},{"id":"c626c8a6-f442-41c9-892e-66fea021693f","type":"action","text":"Barbra hurries away, embarrassed. The man is closer now. He staggers. He reaches for her.","characterId":null,"attributes":{}},{"id":"947268ae-7c02-4bf4-a60a-f1773a8da5f6","type":"action","text":"Johnny pulls him off her. They grapple. Johnny falls and strikes his head on a gravestone, and lies still.","characterId":null,"attributes":{}},{"id":"5c0b267a-e536-48b2-a862-337b82262fa4","type":"action","text":"Barbra runs.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"c542a586-2997-408c-9846-01e8a8698e6e","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"ec9c31f5-cbdd-49eb-a45c-6f26cb43907b","title":"Barbra reaches the farmhouse","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9a0ec458-f3fb-4c48-878f-05ca969cc374","type":"scene_heading","text":"EXT. FARMHOUSE - NIGHT","characterId":null,"attributes":{}},{"id":"5b3da3d0-2149-46fa-bccc-07d81952d3ec","type":"action","text":"A lone farmhouse at the end of a dirt track. Barbra stumbles up the porch steps and through the door, slamming it behind her.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"be9cb7c2-78de-43d0-9b37-a95bba5f8f18","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"32195953-5094-4bec-840e-71f5caff0f3c","title":"Ben boards up the house","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"23f3d31a-c834-47a7-9924-110257d992b1","type":"scene_heading","text":"INT. FARMHOUSE - LIVING ROOM - CONTINUOUS","characterId":null,"attributes":{}},{"id":"34bd1477-1fb5-4c5a-84a7-76e1b32adf6f","type":"action","text":"Dark. Silent. Barbra backs against the wall, breathing hard. Outside, the man from the cemetery stands at the edge of the yard, watching the house.","characterId":null,"attributes":{}},{"id":"6fc74246-d2f5-468a-b7dc-e443fb2ce18f","type":"action","text":"Headlights sweep the windows. A pickup truck skids to a stop. BEN (30s) bursts in carrying a tyre iron.","characterId":null,"attributes":{}},{"id":"8c40648b-392a-4e62-9d77-fd595273785f","type":"action","text":"He checks the windows, finds the doors, and starts tearing up a table to board them shut.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"f852053d-60ba-4d16-a52f-3b9bb25fbafe","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"61747ebb-25ca-47db-96be-3e3290a37b4c","title":"The radio reports","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9e992870-36d4-4f72-b5b3-907a43c7d9cc","type":"scene_heading","text":"INT. FARMHOUSE - LIVING ROOM - LATER","characterId":null,"attributes":{}},{"id":"589faab1-a6ff-44cd-82c8-64708c54219c","type":"action","text":"The windows are boarded. A radio crackles on the mantel. Ben turns it up. A NEWSCASTER reports killings in towns across the eastern states, by people the authorities cannot identify.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"5034090c-4ab5-4f46-a763-013c826eba02","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"b7b839f7-00ee-49f0-a254-a09c6c102391","title":"Beat 'em or burn 'em","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"9234cb9e-f01c-4538-8b4d-b21ebf79c135","type":"scene_heading","text":"EXT. OPEN FIELD - DAY (NEWS FOOTAGE)","characterId":null,"attributes":{}},{"id":"0532c74e-3547-4345-a470-66f35dc21ba1","type":"action","text":"On the television: a posse of armed men and dogs sweeps a field. A reporter catches up with SHERIFF McCLELLAN.","characterId":null,"attributes":{}},{"id":"a6c75d94-2bbc-4da4-b377-edb662015f50","type":"character","text":"SHERIFF MCCLELLAN","characterId":"b2d6ed16-8088-4e92-87df-78c30bb62c25","attributes":{}},{"id":"f21105f4-736d-4e77-ab27-8f0a5ff1380b","type":"dialogue","text":"Yeah, they're dead. They're all messed up.","characterId":null,"attributes":{}},{"id":"f42c1ce1-a46d-43ed-827d-621fd15f56c1","type":"character","text":"SHERIFF MCCLELLAN","characterId":"b2d6ed16-8088-4e92-87df-78c30bb62c25","attributes":{}},{"id":"0216cbf0-8d20-471f-b425-02aa3231ca3d","type":"dialogue","text":"Beat 'em or burn 'em. They go up pretty easy.","characterId":null,"attributes":{}},{"id":"6498e67a-498a-450c-a1d5-96e64aef7bae","type":"transition","text":"CUT TO:","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"},{"id":"669dd3b4-6cb5-45db-bf52-0526a811485a","projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","unitId":"ba57082f-5956-4c2e-a0ad-5f15ccb86096","title":"The Coopers come up from the cellar","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"f056876a-f2ff-4529-94d7-9a67e764fe4b","type":"scene_heading","text":"INT. FARMHOUSE - CELLAR DOOR - NIGHT","characterId":null,"attributes":{}},{"id":"43a589a5-2be0-4ebe-825c-3b5f5b570d59","type":"action","text":"The cellar door opens. HARRY COOPER (40s) climbs up into the light. Behind him, his wife HELEN, and the young couple TOM and JUDY.","characterId":null,"attributes":{}},{"id":"ba61f346-d877-452d-b43e-a466e55cea99","type":"action","text":"Ben and Harry face each other across the room: one wants the house above ground, the other the cellar below it. Outside, the dead gather at the windows.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.265Z","updatedAt":"2026-11-12T04:52:00.273Z"}],"markers":[],"assets":[],"boards":[{"id":"6d971095-e796-41aa-8113-77f57bf4ca13","schemaVersion":2,"projectId":"782a0ef6-72ea-4bf7-81be-cd0ec1ce6c14","name":"Night of the Living Dead","columns":[],"nodes":[{"id":"56d3a789-16b0-4593-90b5-f8f2ea64b87c","boardId":"6d971095-e796-41aa-8113-77f57bf4ca13","columnId":null,"parentId":null,"orderKey":"V","title":"Act One: The cemetery","note":"","kind":"frame","subtype":"","entityId":null,"colour":"","fields":{},"characterIds":[],"end":null,"collapsed":false,"boundUnitId":null,"boundBeatId":null,"createdAt":"2026-11-12T04:52:00.275Z","updatedAt":"2026-11-12T04:52:00.275Z"},{"id":"b21b43b4-2879-4594-af7e-289cf0b6d7d6","boardId":"6d971095-e796-41aa-8113-77f57bf4ca13","columnId":null,"parentId":"56d3a789-16b0-4593-90b5-f8f2ea64b87c","orderKey":"V","title":"Johnny is attacked","note":"","kind":"plot_point","subtype":"","entityId":null,"colour":"","fields":{},"characterIds":[],"end":null,"collapsed":false,"boundUnitId":null,"boundBeatId":null,"createdAt":"2026-11-12T04:52:00.275Z","updatedAt":"2026-11-12T04:52:00.275Z"},{"id":"69b51419-6285-4b5e-a674-19cc324b38a2","boardId":"6d971095-e796-41aa-8113-77f57bf4ca13","columnId":null,"parentId":"b21b43b4-2879-4594-af7e-289cf0b6d7d6","orderKey":"V","title":"The drive out","note":"","kind":"scene","subtype":"","entityId":null,"colour":"","fields":{},"characterIds":[],"end":null,"collapsed":false,"boundUnitId":null,"boundBeatId":null,"createdAt":"2026-11-12T04:52:00.275Z","updatedAt":"2026-11-12T04:52:00.275Z"},{"id":"c606f79c-059e-45f9-9ce7-3d4db6303d87","boardId":"