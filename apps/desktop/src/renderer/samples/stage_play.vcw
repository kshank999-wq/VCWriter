{"formatVersion":3,"generator":"vcwriter","savedAt":"2026-11-12T04:52:00.282Z","project":{"id":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","ownerId":null,"format":"stage_play","title":"Hamlet","author":"William Shakespeare","logline":"","elevatorPitch":"","synopsis":"","genre":"","notes":"Imported from a Final Draft document.","status":"development","posterAssetId":null,"lastOpenedAt":null,"mooring":null,"createdAt":"2026-11-12T04:52:00.282Z","updatedAt":"2026-11-12T04:52:00.293Z"},"settings":{"narratorVoice":null,"autosaveIntervalMs":5000,"snapshotEveryNSaves":20,"includeBeatTitlesInExport":false,"focusMode":false,"markerNumbering":"","markerSymbol":"❦","sectionNumbering":"decimal","outlineCase":"as_typed","includeChapterPagesInExport":true,"paragraphStyle":"indented","scriptFormat":"us","formatOverrides":{"templateName":"","elements":{}},"actBreaks":false,"maxSeconds":0,"episodeCarry":{},"editorIgnoredRules":[],"editorAllowedWords":[],"storyGrid":{},"titlePage":{"title":"","titleImage":"","episode":"","descriptor":"","byline":"","credits":[],"author":"","source":"","sourceAuthor":"","contact":"","draftDate":"","revision":"","notes":""},"castPage":{"heading":"","order":"appearance","time":"The Middle Ages. Winter.","place":"Elsinore, the royal castle of Denmark.","notes":"The play is in five acts."},"chapterPageStyle":{},"book":{},"citations":{}},"tracks":[{"id":"11031d10-eb1b-48e3-a156-fc57f1cf7326","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","name":"Main Plot","kind":"main_plot","color":"#c9a45c","description":"","arc":"","orderKey":"V","collapsed":false,"createdAt":"2026-11-12T04:52:00.282Z","updatedAt":"2026-11-12T04:52:00.282Z"}],"units":[{"id":"385a1ed8-f1dd-4316-b437-68a3e8bc7222","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","trackId":"11031d10-eb1b-48e3-a156-fc57f1cf7326","kind":"scene","title":"ACT I, SCENE I. ELSINORE. A PLATFORM BEFORE THE CASTLE.","sequenceLabel":"Sc. 1","summary":"","notes":"","status":"draft_complete","orderKey":"V","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.287Z","updatedAt":"2026-11-12T04:52:00.287Z"},{"id":"8e05ce3b-b35f-46c8-a557-fc004a743301","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","trackId":"11031d10-eb1b-48e3-a156-fc57f1cf7326","kind":"scene","title":"A room of state in the castle","sequenceLabel":"","summary":"","notes":"","status":"outline","orderKey":"l","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"30d653b7-9388-46a3-96f7-a131b7cbe426","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","trackId":"11031d10-eb1b-48e3-a156-fc57f1cf7326","kind":"scene","title":"Polonius' house","sequenceLabel":"","summary":"","notes":"","status":"outline","orderKey":"t","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"11232bc5-e1f3-4ae5-9710-0f0f0e16a209","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","trackId":"11031d10-eb1b-48e3-a156-fc57f1cf7326","kind":"scene","title":"The platform","sequenceLabel":"","summary":"","notes":"","status":"outline","orderKey":"x","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"ee804772-5351-4b01-b834-daa5f5dcc574","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","trackId":"11031d10-eb1b-48e3-a156-fc57f1cf7326","kind":"scene","title":"Another part of the platform","sequenceLabel":"","summary":"","notes":"","status":"outline","orderKey":"z","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"}],"beats":[{"id":"33f3a194-45bb-41f4-94d9-79a5dbc883be","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"385a1ed8-f1dd-4316-b437-68a3e8bc7222","title":"The Ghost on the battlements","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"79b8187c-0bc8-47db-ad8a-8dc6e037e1c0","type":"scene_heading","text":"ACT I, SCENE I. ELSINORE. A PLATFORM BEFORE THE CASTLE.","characterId":null,"attributes":{}},{"id":"04c3b123-814d-468b-9746-c2f3a46c2974","type":"action","text":"Enter Francisco and Barnardo, two sentinels.","characterId":null,"attributes":{}},{"id":"49f07db1-aa37-49ab-87ff-268c3a61cb47","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"445d6801-69dd-492d-bca2-96176e29795e","type":"dialogue","text":"Who’s there?","characterId":null,"attributes":{}},{"id":"2de59980-eb7f-4041-a134-40f3f765e3fb","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"8cad0f47-1746-4128-9457-88e6d9d98aea","type":"dialogue","text":"Nay, answer me. Stand and unfold yourself.","characterId":null,"attributes":{}},{"id":"f4cc9994-cf17-46b6-96c6-6e5de34f4468","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"793adfb6-816c-4feb-b759-16b06cbd4b48","type":"dialogue","text":"Long live the King!","characterId":null,"attributes":{}},{"id":"d3220daf-b43e-43c1-8243-72392b7bef4e","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"5e666f59-a165-482a-8fa0-4b8c3cd086fa","type":"dialogue","text":"Barnardo?","characterId":null,"attributes":{}},{"id":"1adc4fc4-9597-4855-a1d8-6b37d3fce385","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"a94956a5-e7e7-486a-8924-00bf10562571","type":"dialogue","text":"He.","characterId":null,"attributes":{}},{"id":"ece1f2e9-168d-4504-acdb-56b8d1957aea","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"c338f3ab-da60-45c8-acc9-1c5f78570a05","type":"dialogue","text":"You come most carefully upon your hour.","characterId":null,"attributes":{}},{"id":"d0135b4c-5270-4af3-8cef-f4f2562b79fd","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"2284a3a8-7f10-4413-aa48-b30f9fb1b55b","type":"dialogue","text":"’Tis now struck twelve. Get thee to bed, Francisco.","characterId":null,"attributes":{}},{"id":"b334dda5-18cd-468a-82ab-ef70499414f3","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"c7789a71-59b6-433f-b3fe-755e796d1ebb","type":"dialogue","text":"For this relief much thanks. ’Tis bitter cold, And I am sick at heart.","characterId":null,"attributes":{}},{"id":"9bef1220-1282-471e-95f1-9d40babca201","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"01d7550c-7a72-44e3-ba00-013aba84b8c6","type":"dialogue","text":"Have you had quiet guard?","characterId":null,"attributes":{}},{"id":"9d96e974-bef1-4b42-a716-6048312df02d","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"0e3457c2-95f0-4ae5-85af-4c980d54fd8c","type":"dialogue","text":"Not a mouse stirring.","characterId":null,"attributes":{}},{"id":"efdfe166-6c32-4279-9141-98e74f813ba6","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"62d0fa07-e9ca-4664-8f6e-dd415ef0229a","type":"dialogue","text":"Well, good night. If you do meet Horatio and Marcellus, The rivals of my watch, bid them make haste.","characterId":null,"attributes":{}},{"id":"eef730c4-0c2a-4fe5-9b5b-6a9a9a3b3cff","type":"action","text":"Enter Horatio and Marcellus.","characterId":null,"attributes":{}},{"id":"08e8f7ce-71d7-4f56-bcfa-703242a762ef","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"2e891561-7c10-40d3-bc3a-41bd4d7aeea2","type":"dialogue","text":"I think I hear them. Stand, ho! Who is there?","characterId":null,"attributes":{}},{"id":"6f7849ef-8542-4768-9ccc-5996395b7ee0","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"2bbd9055-709e-41b5-aea7-cc9e088b53ba","type":"dialogue","text":"Friends to this ground.","characterId":null,"attributes":{}},{"id":"9833f907-ff1c-45c5-b7be-81e4337134d3","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"1b94230c-8e77-4770-8fb6-0fa66335aa30","type":"dialogue","text":"And liegemen to the Dane.","characterId":null,"attributes":{}},{"id":"fcbb29b2-7aab-4d9f-a258-e913ddb203d2","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"b14c0baf-eeed-4a71-be19-70b98f634967","type":"dialogue","text":"Give you good night.","characterId":null,"attributes":{}},{"id":"9ecc2511-ab44-4252-be8e-1bf5d7a539c6","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"ebd1a7a8-7053-4267-8dd2-b816a8044afe","type":"dialogue","text":"O, farewell, honest soldier, who hath reliev’d you?","characterId":null,"attributes":{}},{"id":"d367805e-93d0-4ccd-9e1e-d4801a635634","type":"character","text":"FRANCISCO","characterId":"2b62329e-fd21-4bfd-914b-cee261428eb4","attributes":{}},{"id":"31099028-dc9a-4fec-8731-fe027da55bcb","type":"dialogue","text":"Barnardo has my place. Give you good-night.","characterId":null,"attributes":{}},{"id":"4d52af26-084c-474e-b52a-06c351d36205","type":"action","text":"Exit.","characterId":null,"attributes":{}},{"id":"076aeed2-4f09-4612-9682-15f3567d00d6","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"6b37d204-9ca2-45c4-97e8-f9f430969eee","type":"dialogue","text":"Holla, Barnardo!","characterId":null,"attributes":{}},{"id":"6de5fc98-5dec-46e4-b36d-436da0b52ed6","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"ea2d4bd7-4346-475f-bda3-2825cd495200","type":"dialogue","text":"Say, what, is Horatio there?","characterId":null,"attributes":{}},{"id":"b8f8270f-787c-4f72-ad24-6588b6e74880","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"35a28a6a-3481-4234-81a9-a3a1a750474d","type":"dialogue","text":"A piece of him.","characterId":null,"attributes":{}},{"id":"bc31fa6a-1059-4198-8c94-b3a4d7a791a8","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"7da08253-cd82-4f4e-9687-1f5771d25451","type":"dialogue","text":"Welcome, Horatio. Welcome, good Marcellus.","characterId":null,"attributes":{}},{"id":"654fcea9-9232-4edd-a0aa-033753a279e2","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"bdda23ec-8b06-46ce-b7f9-11d74d41b43f","type":"dialogue","text":"What, has this thing appear’d again tonight?","characterId":null,"attributes":{}},{"id":"e2d85e99-a333-4b7b-bd1c-2e8e2f246141","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"2d74f842-a6b8-4691-b9da-5697dabad3e0","type":"dialogue","text":"I have seen nothing.","characterId":null,"attributes":{}},{"id":"0b261161-41cd-4fa8-9b3c-5d81bceb230e","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"950a5873-933c-47c2-a9ec-ffc8f80969eb","type":"dialogue","text":"Horatio says ’tis but our fantasy, And will not let belief take hold of him Touching this dreaded sight, twice seen of us. Therefore I have entreated him along With us to watch the minutes of this night, That if again this apparition come He may approve our eyes and speak to it.","characterId":null,"attributes":{}},{"id":"1bbb79bf-85c1-4d01-ab2e-bf5fb92d4170","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"f1d1b696-2e86-4ee8-9d87-4e9e5db2a52e","type":"dialogue","text":"Tush, tush, ’twill not appear.","characterId":null,"attributes":{}},{"id":"46e8a06d-7e66-41de-8792-95f496605980","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"fa6118b1-4501-4a0a-ac7e-52c5c75a3e09","type":"dialogue","text":"Sit down awhile, And let us once again assail your ears, That are so fortified against our story, What we two nights have seen.","characterId":null,"attributes":{}},{"id":"c7c42f3d-dd1e-4c8c-b8af-e168d959a042","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"0328d2fc-bf43-4bb2-91db-6d09ed07b0bf","type":"dialogue","text":"Well, sit we down, And let us hear Barnardo speak of this.","characterId":null,"attributes":{}},{"id":"0745200d-8218-44a5-9ed0-6c13ddc69e56","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"2f65cf22-e662-4f7a-accd-63a956545ff4","type":"dialogue","text":"Last night of all, When yond same star that’s westward from the pole, Had made his course t’illume that part of heaven Where now it burns, Marcellus and myself, The bell then beating one—","characterId":null,"attributes":{}},{"id":"88afd4d4-8b1f-4a97-bacf-49b7f86ba4df","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"00e64dec-d019-4e67-8605-4db38efc5f0b","type":"dialogue","text":"Peace, break thee off. Look where it comes again.","characterId":null,"attributes":{}},{"id":"33037db0-7b51-4606-9bc5-69697d308488","type":"action","text":"Enter Ghost.","characterId":null,"attributes":{}},{"id":"a4d12359-9e90-4fdf-ac29-14cac560958a","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"e0157597-79ec-4e52-aa4f-3c0cb8adb797","type":"dialogue","text":"In the same figure, like the King that’s dead.","characterId":null,"attributes":{}},{"id":"997e8873-0285-4db3-8987-4e3c5396dc6d","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"1e28173a-e6a4-4f64-b178-8f5aed20cd1e","type":"dialogue","text":"Thou art a scholar; speak to it, Horatio.","characterId":null,"attributes":{}},{"id":"421f4f80-169a-4d10-97f9-e2e61d8fcc23","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"775eb1be-de02-4428-8f61-f5d49883508b","type":"dialogue","text":"Looks it not like the King? Mark it, Horatio.","characterId":null,"attributes":{}},{"id":"6e38e3c6-637a-4846-9caa-0798f81c2981","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"f7f8b06e-c524-4be5-91e4-a42bcf3c42c0","type":"dialogue","text":"Most like. It harrows me with fear and wonder.","characterId":null,"attributes":{}},{"id":"a0fcb356-c5bb-4131-a992-55b9c334b300","type":"action","text":"BARNARDO It would be spoke to.","characterId":null,"attributes":{}},{"id":"eae58640-3f5f-4ccb-beb9-8d628431d8cd","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"d5297737-bee4-464d-af42-0ba317d67e55","type":"dialogue","text":"Question it, Horatio.","characterId":null,"attributes":{}},{"id":"b5e75526-9f7c-463d-a38b-678a0ab46323","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"abb3d9b5-40e2-4897-a09c-0606724df5a9","type":"dialogue","text":"What art thou that usurp’st this time of night, Together with that fair and warlike form In which the majesty of buried Denmark Did sometimes march? By heaven I charge thee speak.","characterId":null,"attributes":{}},{"id":"05e45125-430b-4e95-8804-75596e3ca810","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"f5c0650a-c19a-4860-a4f4-4808262865ff","type":"dialogue","text":"It is offended.","characterId":null,"attributes":{}},{"id":"86476b22-481d-42cb-aea0-a28a33b58a05","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"a078cdb6-f981-4917-9007-7c4feca695d9","type":"dialogue","text":"See, it stalks away.","characterId":null,"attributes":{}},{"id":"f51837f3-e50e-4755-b1c3-57c76225c020","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"22da9e09-7545-4736-9f08-97110454ad21","type":"dialogue","text":"Stay! speak, speak! I charge thee speak!","characterId":null,"attributes":{}},{"id":"3d0931df-a1c6-4056-b2e5-f63542d6ba00","type":"action","text":"Exit Ghost.","characterId":null,"attributes":{}},{"id":"64226c88-697c-48b6-95e4-ac0cdf736588","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"f6eb0a2e-1120-404b-a8f2-c6566eae1bbf","type":"dialogue","text":"’Tis gone, and will not answer.","characterId":null,"attributes":{}},{"id":"7cebd63b-ddb5-4525-874e-3636e7de7345","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"64146bff-e3c5-420c-9c0b-ef3db528641a","type":"dialogue","text":"How now, Horatio! You tremble and look pale. Is not this something more than fantasy? What think you on’t?","characterId":null,"attributes":{}},{"id":"f77b7e20-1d31-4ded-9338-3b31ec4cda49","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"4ffc0394-624b-4311-85c8-a1ef79ae3e53","type":"dialogue","text":"Before my God, I might not this believe Without the sensible and true avouch Of mine own eyes.","characterId":null,"attributes":{}},{"id":"eef8ee3b-8338-400e-935e-023b46cd8255","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"807da3f5-a64b-4431-b8a6-c6c9569843e1","type":"dialogue","text":"Is it not like the King?","characterId":null,"attributes":{}},{"id":"3261c52a-ddf6-4fe2-a433-3d1448b3b893","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"1a824b6f-39b9-43cc-835f-e042eef4dce9","type":"dialogue","text":"As thou art to thyself: Such was the very armour he had on When he th’ambitious Norway combated; So frown’d he once, when in an angry parle He smote the sledded Polacks on the ice. ’Tis strange.","characterId":null,"attributes":{}},{"id":"449ad095-da64-4777-bdca-e27be2a68bcd","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"a4d34e2c-86a3-434d-a285-db4acf45f311","type":"dialogue","text":"Thus twice before, and jump at this dead hour, With martial stalk hath he gone by our watch.","characterId":null,"attributes":{}},{"id":"d5f22307-4724-43c7-a3bf-0f746cc802ff","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"3b2058ae-bdf8-40da-93be-53b5ba652b07","type":"dialogue","text":"In what particular thought to work I know not; But in the gross and scope of my opinion, This bodes some strange eruption to our state.","characterId":null,"attributes":{}},{"id":"71c9e816-957c-4c37-bc20-db6082a4d6ba","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"bc2e974b-f6c6-4968-95f9-23fff52a4289","type":"dialogue","text":"Good now, sit down, and tell me, he that knows, Why this same strict and most observant watch So nightly toils the subject of the land, And why such daily cast of brazen cannon And foreign mart for implements of war; Why such impress of shipwrights, whose sore task Does not divide the Sunday from the week. What might be toward, that this sweaty haste Doth make the night joint-labourer with the day: Who is’t that can inform me?","characterId":null,"attributes":{}},{"id":"ec2cb854-9cb5-46f7-93aa-5307516ec656","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"1b9db5a6-755a-4c97-9f7f-cd53085cde8d","type":"dialogue","text":"That can I; At least, the whisper goes so. Our last King, Whose image even but now appear’d to us, Was, as you know, by Fortinbras of Norway, Thereto prick’d on by a most emulate pride, Dar’d to the combat; in which our valiant Hamlet, For so this side of our known world esteem’d him, Did slay this Fortinbras; who by a seal’d compact, Well ratified by law and heraldry, Did forfeit, with his life, all those his lands Which he stood seiz’d of, to the conqueror; Against the which, a moiety competent Was gaged by our King; which had return’d To the inheritance of Fortinbras, Had he been vanquisher; as by the same cov’nant And carriage of the article design’d, His fell to Hamlet. Now, sir, young Fortinbras, Of unimproved mettle, hot and full, Hath in the skirts of Norway, here and there, Shark’d up a list of lawless resolutes, For food and diet, to some enterprise That hath a stomach in’t; which is no other, As it doth well appear unto our state, But to recover of us by strong hand And terms compulsatory, those foresaid lands So by his father lost. And this, I take it, Is the main motive of our preparations, The source of this our watch, and the chief head Of this post-haste and rummage in the land.","characterId":null,"attributes":{}},{"id":"3ab54502-4435-455d-a464-c35a66edf9b8","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"2b046bdd-77c1-49d2-9f2c-6f273f5f1edf","type":"dialogue","text":"I think it be no other but e’en so: Well may it sort that this portentous figure Comes armed through our watch so like the King That was and is the question of these wars.","characterId":null,"attributes":{}},{"id":"4da155da-bf36-492f-8ac7-87a0fe6cd20c","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"68143999-895f-4b14-bf30-da4231f437bf","type":"dialogue","text":"A mote it is to trouble the mind’s eye. In the most high and palmy state of Rome, A little ere the mightiest Julius fell, The graves stood tenantless and the sheeted dead Did squeak and gibber in the Roman streets; As stars with trains of fire and dews of blood, Disasters in the sun; and the moist star, Upon whose influence Neptune’s empire stands, Was sick almost to doomsday with eclipse. And even the like precurse of fierce events, As harbingers preceding still the fates And prologue to the omen coming on, Have heaven and earth together demonstrated Unto our climatures and countrymen.","characterId":null,"attributes":{}},{"id":"009b59ff-64bc-4798-8d92-e155289788b1","type":"action","text":"Re-enter Ghost.","characterId":null,"attributes":{}},{"id":"6bbdba3e-5eb6-4b27-8895-1e359e952e1e","type":"action","text":"But, soft, behold! Lo, where it comes again! I’ll cross it, though it blast me. Stay, illusion! If thou hast any sound, or use of voice, Speak to me. If there be any good thing to be done, That may to thee do ease, and grace to me, Speak to me. If thou art privy to thy country’s fate, Which, happily, foreknowing may avoid, O speak! Or if thou hast uphoarded in thy life Extorted treasure in the womb of earth, For which, they say, you spirits oft walk in death, Speak of it. Stay, and speak!","characterId":null,"attributes":{}},{"id":"6bddb1c4-cd50-4b96-a604-c81076ce0ee3","type":"action","text":"The cock crows.","characterId":null,"attributes":{}},{"id":"864bbea7-cd07-4c32-9c74-ed73f800f455","type":"action","text":"Stop it, Marcellus!","characterId":null,"attributes":{}},{"id":"5bc36539-1a44-44e1-a3a3-e07d80b3f2df","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"863cbae6-78d6-4ad0-8540-12eef3b85b6c","type":"dialogue","text":"Shall I strike at it with my partisan?","characterId":null,"attributes":{}},{"id":"2b3c9bf5-f7d8-4fcf-8111-72b446508a7d","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"17594890-bb48-4943-8f3a-e5195a0500b3","type":"dialogue","text":"Do, if it will not stand.","characterId":null,"attributes":{}},{"id":"dfd31d0b-7660-4fbc-8c94-66a2104e8a72","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"2014cc8f-6973-4694-a93a-05b7567db0f1","type":"dialogue","text":"’Tis here!","characterId":null,"attributes":{}},{"id":"61cdfcc0-1383-4336-828d-715026d778c8","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"d14b9b6e-30fc-464b-9852-d6a748db8bd0","type":"dialogue","text":"’Tis here!","characterId":null,"attributes":{}},{"id":"e05bacdc-c382-4721-b0b2-259a3c651d50","type":"action","text":"Exit Ghost.","characterId":null,"attributes":{}},{"id":"6b9d2283-8712-41aa-ad2f-e54a3e69b4c5","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"beffeacb-2ce9-4253-b7d6-e7a583f5b415","type":"dialogue","text":"’Tis gone! We do it wrong, being so majestical, To offer it the show of violence, For it is as the air, invulnerable, And our vain blows malicious mockery.","characterId":null,"attributes":{}},{"id":"dd9963e7-71cd-4548-bbba-35987128039f","type":"character","text":"BARNARDO","characterId":"0c86c61b-ecfd-44c2-a6c0-e2a421d62389","attributes":{}},{"id":"0c88a234-a2a4-4216-8bff-b898b749e64a","type":"dialogue","text":"It was about to speak, when the cock crew.","characterId":null,"attributes":{}},{"id":"605ff50c-6c08-4ac1-b21b-43d6e542c95f","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"8b2d975b-c07a-4e25-a6df-3b0384e3dcc9","type":"dialogue","text":"And then it started, like a guilty thing Upon a fearful summons. I have heard The cock, that is the trumpet to the morn, Doth with his lofty and shrill-sounding throat Awake the god of day; and at his warning, Whether in sea or fire, in earth or air, Th’extravagant and erring spirit hies To his confine. And of the truth herein This present object made probation.","characterId":null,"attributes":{}},{"id":"62c37f85-e43e-4e9c-b1c7-852066a5a1c4","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"41918a2e-d391-4ef2-9fd6-eec9278bb95d","type":"dialogue","text":"It faded on the crowing of the cock. Some say that ever ’gainst that season comes Wherein our Saviour’s birth is celebrated, The bird of dawning singeth all night long; And then, they say, no spirit dare stir abroad, The nights are wholesome, then no planets strike, No fairy takes, nor witch hath power to charm; So hallow’d and so gracious is the time.","characterId":null,"attributes":{}},{"id":"2bb73ee0-791c-4614-b4dc-d5540a966dc8","type":"character","text":"HORATIO","characterId":"1e8f5a46-f740-4d7e-a115-9a431cb33927","attributes":{}},{"id":"964d8fa5-088d-4c65-8237-9c7e5e21245b","type":"dialogue","text":"So have I heard, and do in part believe it. But look, the morn in russet mantle clad, Walks o’er the dew of yon high eastward hill. Break we our watch up, and by my advice, Let us impart what we have seen tonight Unto young Hamlet; for upon my life, This spirit, dumb to us, will speak to him. Do you consent we shall acquaint him with it, As needful in our loves, fitting our duty?","characterId":null,"attributes":{}},{"id":"c9b5d60c-913f-4bc6-9f77-445c4bf2379b","type":"character","text":"MARCELLUS","characterId":"4449f1fd-4d37-4fef-af9a-d9b1290657c7","attributes":{}},{"id":"c09e024d-67b3-4eab-9fc6-e80ecb470c7f","type":"dialogue","text":"Let’s do’t, I pray, and I this morning know Where we shall find him most conveniently.","characterId":null,"attributes":{}},{"id":"97ce0443-6374-420f-b342-71f5f96a6024","type":"action","text":"Exeunt.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.287Z","updatedAt":"2026-11-12T04:52:00.291Z"},{"id":"8bec723e-4b36-49c9-b762-2056de5874b4","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"8e05ce3b-b35f-46c8-a557-fc004a743301","title":"The new King speaks of his brother's death","summary":"","status":"planned","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"02c6855f-82ce-407a-b89d-eb11a135433a","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"8e05ce3b-b35f-46c8-a557-fc004a743301","title":"Hamlet in black, alone","summary":"","status":"planned","orderKey":"l","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"9ec5a9f4-806d-47c4-99c7-b6afa19df6f7","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"8e05ce3b-b35f-46c8-a557-fc004a743301","title":"Horatio tells Hamlet of the Ghost","summary":"","status":"planned","orderKey":"t","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"fc7592d1-822e-4818-a56e-c17940179003","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"30d653b7-9388-46a3-96f7-a131b7cbe426","title":"Laertes warns Ophelia","summary":"","status":"planned","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.292Z","updatedAt":"2026-11-12T04:52:00.292Z"},{"id":"7379a105-a93d-424c-950d-4594dafee49e","projectId":"72e7fa75-c848-4b6b-9ef8-885ed7ef374a","unitId":"30d653b7-9388-46a3-96f7-a131b7cbe426","title":"Polonius's precepts","summary":"","status":"planned","orderKey":"l","inScript":true,"headingShown":true,"manuscript":{"elements":[]},"revisionName":"Draft 1","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"o