:"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.297Z","updatedAt":"2026-11-12T04:52:00.297Z"},{"id":"0b8ae0a0-ed7d-4ee2-807b-f3716bd021b1","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","trackId":"8d554e2a-3891-40e4-859f-82c7d735145d","kind":"scene","title":"INT. STOKE MORAN - BEDROOM - NIGHT","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"z","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.297Z","updatedAt":"2026-11-12T04:52:00.297Z"}],"beats":[{"id":"d683908c-3a28-42dc-8478-e127e4873a6e","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"2650c66b-d3d2-434f-bcfc-cf2cfeafa880","title":"Seen but not observed","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"26d22da8-dbf4-4c7a-904e-9b131ed4b37a","type":"scene_heading","text":"INT. 221B BAKER STREET - SITTING ROOM - NIGHT","characterId":null,"attributes":{}},{"id":"03f1036c-4e51-4a08-a97b-15fa2691735f","type":"action","text":"Lamplight. SHERLOCK HOLMES throws himself into an armchair and lights a cigarette. DR. WATSON stands by the fire.","characterId":null,"attributes":{}},{"id":"166ddf93-399c-4dac-ab9a-0496f6f0b72f","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"7546777a-6a7d-4939-8583-111801247a01","type":"dialogue","text":"You see, but you do not observe. The distinction is clear. For example, you have frequently seen the steps which lead up from the hall to this room.","characterId":null,"attributes":{}},{"id":"23c0bf4c-667b-4164-a3f9-bd0756f087d8","type":"character","text":"WATSON","characterId":"1cc07abf-2e5b-4b0d-b082-79d7f3e424f8","attributes":{}},{"id":"f218b0e2-b043-4474-97f5-9cdb7ca29c7e","type":"dialogue","text":"Frequently.","characterId":null,"attributes":{}},{"id":"0a023ee1-3339-4362-8ab4-9243ac670235","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"b95cbdac-8014-4bd8-91e2-a2ee9f22cb3a","type":"dialogue","text":"How often?","characterId":null,"attributes":{}},{"id":"f2272006-3a94-4ce2-88fb-7809c4a8d96c","type":"character","text":"WATSON","characterId":"1cc07abf-2e5b-4b0d-b082-79d7f3e424f8","attributes":{}},{"id":"fa00a374-f3dc-47c8-9df7-59602f4c79ab","type":"dialogue","text":"Well, some hundreds of times.","characterId":null,"attributes":{}},{"id":"03f632d1-5d15-428c-98a0-489b587e58f0","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"8d5874fc-a2e0-4c76-b191-e6bedf5414e6","type":"dialogue","text":"Then how many are there?","characterId":null,"attributes":{}},{"id":"565dbe29-540b-49d9-9dae-aaa85b0832d4","type":"character","text":"WATSON","characterId":"1cc07abf-2e5b-4b0d-b082-79d7f3e424f8","attributes":{}},{"id":"63fb8762-f136-41a7-a9d7-707d7ca68183","type":"dialogue","text":"How many? I don't know.","characterId":null,"attributes":{}},{"id":"787553ae-6d18-40bb-af43-7b41e1e20e61","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"c5de3439-1148-4f38-bb5f-79e9b3723bd8","type":"dialogue","text":"Quite so! You have not observed. And yet you have seen. That is just my point. Now, I know that there are seventeen steps, because I have both seen and observed.","characterId":null,"attributes":{}},{"id":"9476b6fa-11a8-44fa-8cec-b274532e88bc","type":"action","text":"Hooves and wheels in the street below. A bell. Heavy steps on the stair.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.294Z","updatedAt":"2026-11-12T04:52:00.298Z"},{"id":"73873a13-51e5-4402-a396-4d732137a271","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"aa961296-4163-475a-ae70-24c09caf2555","title":"Jabez Wilson, read at a glance","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"8d8e28c6-15e8-4b46-a8df-21367e0bf55d","type":"scene_heading","text":"INT. 221B BAKER STREET - SITTING ROOM - DAY","characterId":null,"attributes":{}},{"id":"d1eca4fa-1411-4a36-b8c0-0effb4b4218a","type":"action","text":"JABEZ WILSON, a stout pawnbroker with a blaze of red hair, sits stiffly as Holmes looks him over.","characterId":null,"attributes":{}},{"id":"cd010182-bb7a-4be5-9f3f-5aa5bbc07151","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"c8853455-7671-4273-8113-438be3f1eb8a","type":"dialogue","text":"Beyond the obvious facts that he has at some time done manual labour, that he takes snuff, that he is a Freemason, that he has been in China, and that he has done a considerable amount of writing lately, I can deduce nothing else.","characterId":null,"attributes":{}},{"id":"30f4ec53-8fca-4d44-8023-9162c2a67436","type":"action","text":"Wilson starts up in his chair.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.296Z","updatedAt":"2026-11-12T04:52:00.298Z"},{"id":"c10d55d9-1b86-4922-b058-dec9a9d131eb","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"1db25846-99ed-42b5-a816-44e2491fe515","title":"A three pipe problem","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"437d033f-ad4c-41a0-b55a-0f362b7d41e4","type":"scene_heading","text":"INT. 221B BAKER STREET - SITTING ROOM - LATER","characterId":null,"attributes":{}},{"id":"50bd814b-f2bf-46a5-94e7-a55aa635396f","type":"character","text":"WATSON","characterId":"1cc07abf-2e5b-4b0d-b082-79d7f3e424f8","attributes":{}},{"id":"c831cd64-df3f-40df-bcb6-f47385d0a90e","type":"dialogue","text":"What are you going to do, then?","characterId":null,"attributes":{}},{"id":"5111ac3a-6f5c-4dbf-8a6a-7dd7ffaa7ddc","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"730afa3f-b46d-4531-89a6-b59788b2ec56","type":"dialogue","text":"To smoke. It is quite a three pipe problem, and I beg that you won't speak to me for fifty minutes.","characterId":null,"attributes":{}},{"id":"747a2f48-400b-4338-90d0-c037ba5d7e8c","type":"action","text":"He curls up in his chair, knees drawn to his chin, eyes closed, the black clay pipe jutting out.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.296Z","updatedAt":"2026-11-12T04:52:00.298Z"},{"id":"87ce503b-056c-4fd1-a3a0-9fd84019f6dd","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"ffb17cc9-7a3b-417f-9571-02aec6e1655d","title":"Helen Stoner's terror","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"310151f9-2065-412d-b369-2a336ee0c488","type":"scene_heading","text":"INT. 221B BAKER STREET - SITTING ROOM - EARLY MORNING","characterId":null,"attributes":{}},{"id":"a98823eb-32c0-4976-b4a6-a8cb08c0f4e0","type":"action","text":"A WOMAN dressed in black and heavily veiled sits by the fire. HELEN STONER.","characterId":null,"attributes":{}},{"id":"3d950b17-ec95-42bb-96f9-884060c4f740","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"921a940c-ecbc-416e-94cb-352e9fa08d61","type":"dialogue","text":"Pray draw up to it, and I shall order you a cup of hot coffee, for I observe that you are shivering.","characterId":null,"attributes":{}},{"id":"723ab903-cfe3-4108-987b-0157f5fbe825","type":"character","text":"HELEN STONER","characterId":"7732fbce-7ea5-44ae-8db5-2b8efeafa5d0","attributes":{}},{"id":"a1ae9b85-d89f-48c4-99b2-1881ceb4c72b","type":"dialogue","text":"It is not cold which makes me shiver.","characterId":null,"attributes":{}},{"id":"485e3e9f-376b-44e2-bfbc-95e8e43f1b16","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"09268a69-bc6b-4608-8d3e-09a735ea7863","type":"dialogue","text":"What, then?","characterId":null,"attributes":{}},{"id":"437ddb09-2187-4007-b4cb-77ada49806f0","type":"character","text":"HELEN STONER","characterId":"7732fbce-7ea5-44ae-8db5-2b8efeafa5d0","attributes":{}},{"id":"496e465c-b0b4-483b-97b0-348cef0e77af","type":"dialogue","text":"It is fear, Mr. Holmes. It is terror.","characterId":null,"attributes":{}},{"id":"bd0b0211-b7be-4585-84f8-775627e71f3b","type":"action","text":"She raises her veil: her face drawn and grey, her eyes those of a hunted animal.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.297Z","updatedAt":"2026-11-12T04:52:00.298Z"},{"id":"f5ad592b-08e9-4440-8ee7-294bd30b9f20","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"0b8ae0a0-ed7d-4ee2-807b-f3716bd021b1","title":"The speckled band","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"24ec200a-36b3-4b40-a4a8-3e618af2670b","type":"scene_heading","text":"INT. STOKE MORAN - BEDROOM - NIGHT","characterId":null,"attributes":{}},{"id":"d6fc16dd-a496-4818-a101-c88deac481bc","type":"action","text":"Darkness. Holmes and Watson wait without a light. A low, clear whistle. Holmes strikes a match and lashes at the bell-pull with his cane.","characterId":null,"attributes":{}},{"id":"83c53cfa-97a0-4863-b4e9-f33d7551518c","type":"character","text":"HOLMES","characterId":"96d9905c-8072-4a02-b8d4-c83f04d4c23c","attributes":{}},{"id":"d7ec3905-b6de-43ea-8022-cb55a7b749a1","type":"parenthetical","text":"(whispering)","characterId":null,"attributes":{}},{"id":"c554ca9e-b5e6-4c73-82f2-32dd5da02ea4","type":"dialogue","text":"The band! the speckled band!","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.297Z","updatedAt":"2026-11-12T04:52:00.298Z"}],"markers":[{"id":"9146c6d5-d0e6-4071-9181-b1d5b96095a1","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"2650c66b-d3d2-434f-bcfc-cf2cfeafa880","kind":"episode","title":"A Scandal in Bohemia","notes":"","page":{"include":false,"opensRecto":null,"sheetBefore":null,"showNumber":true,"showTitle":true,"epigraph":"","summary":"","suggestedSummary":"","suggestedAt":null,"template":"book","layout":null,"rule":null,"dropInches":null,"openingLines":null,"blankBefore":false,"backBlank":false,"assetId":null,"graphicWidth":40,"image":null,"align":"center"},"cast":[],"titlePage":{"title":"","titleImage":"","episode":"Episode 1","descriptor":"","byline":"","credits":[],"author":"","source":"","sourceAuthor":"","contact":"","draftDate":"","revision":"","notes":""},"createdAt":"2026-11-12T04:52:00.296Z","updatedAt":"2026-11-12T04:52:00.296Z"},{"id":"ab2ba609-d0c6-456d-9c3d-28ecae4cd19b","projectId":"73a58ffc-1148-4297-b047-05e6fe49c54f","unitId":"aa961296-4163-475a-ae70-24c09caf2555","kind":"episode","title":"The Red-Headed League","notes":"","page":{"include":false,"opensRecto":null,"sheetBefore":null,"sho