{"formatVersion":3,"generator":"vcwriter","savedAt":"2026-11-12T04:52:00.307Z","project":{"id":"65fc93a1-8486-4aee-b72f-b3221578b3fe","ownerId":null,"format":"instructional","title":"Plain and Clear","author":"A. Writer","logline":"","elevatorPitch":"","synopsis":"","genre":"","notes":"Imported from plain text.","status":"development","posterAssetId":null,"lastOpenedAt":null,"mooring":null,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.308Z"},"settings":{"narratorVoice":null,"autosaveIntervalMs":5000,"snapshotEveryNSaves":20,"includeBeatTitlesInExport":false,"focusMode":false,"markerNumbering":"","markerSymbol":"❦","sectionNumbering":"decimal","outlineCase":"as_typed","includeChapterPagesInExport":true,"paragraphStyle":"indented","scriptFormat":"us","formatOverrides":{"templateName":"","elements":{}},"actBreaks":false,"maxSeconds":0,"episodeCarry":{},"editorIgnoredRules":[],"editorAllowedWords":[],"storyGrid":{},"titlePage":{"title":"","titleImage":"","episode":"","descriptor":"","byline":"","credits":[],"author":"","source":"","sourceAuthor":"","contact":"","draftDate":"","revision":"","notes":""},"castPage":{"heading":"","order":"appearance","time":"","place":"","notes":""},"chapterPageStyle":{},"book":{},"citations":{}},"tracks":[{"id":"272f6def-de5e-45da-97a7-f74b58bc1408","projectId":"65fc93a1-8486-4aee-b72f-b3221578b3fe","name":"Main Plot","kind":"main_plot","color":"#c9a45c","description":"","arc":"","orderKey":"V","collapsed":false,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.307Z"}],"units":[{"id":"91dafe55-0d1b-4ab7-b542-0020b3228bd0","projectId":"65fc93a1-8486-4aee-b72f-b3221578b3fe","trackId":"272f6def-de5e-45da-97a7-f74b58bc1408","kind":"chapter","title":"Writing Clear Sentences","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"V","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.308Z"},{"id":"cd424198-f9b1-41cc-9c70-a2f1e83a2a83","projectId":"65fc93a1-8486-4aee-b72f-b3221578b3fe","trackId":"272f6def-de5e-45da-97a7-f74b58bc1408","kind":"chapter","title":"Building Paragraphs","sequenceLabel":"","summary":"","notes":"","status":"draft_complete","orderKey":"l","collapsed":false,"inScript":true,"headingShown":true,"grid":{"value":"","polarity":"","polarityStart":"","polarityEnd":"","purposes":[],"otherPurpose":"","turn":"","purpose":"","conflict":"","event":"","pov":"","inciting":"","crisis":"","climax":"","resolution":""},"aiRead":null,"origin":null,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.308Z"}],"beats":[{"id":"4bd72cc7-261f-460e-b53d-1be56337715a","projectId":"65fc93a1-8486-4aee-b72f-b3221578b3fe","unitId":"91dafe55-0d1b-4ab7-b542-0020b3228bd0","title":"One idea, one sentence","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"7d485e55-5e7e-4714-8367-3d3f3eb32ec5","type":"paragraph","text":"Every sentence makes a promise to the reader: follow me and you will understand one thing more than you did. This chapter is about keeping that promise.[^45067b]","characterId":null,"attributes":{}},{"id":"0d2fd91a-fee2-43fe-b5bd-ae589c309070","type":"paragraph","text":"1.1 One idea per sentence","characterId":null,"attributes":{}},{"id":"6c051b26-25d7-4c0c-a5cc-663182111881","type":"paragraph","text":"A sentence that carries two ideas asks the reader to hold both at once. Split it, and each idea gets the reader's full attention.[^167001]","characterId":null,"attributes":{}},{"id":"c99c58e8-1940-4320-98cc-1d0a5f5a10ab","type":"paragraph","text":"Compare: The committee met on Tuesday and decided, after reviewing the budget, which had grown, to delay the project. With: The committee met on Tuesday. After reviewing the budget, it decided to delay the project.","characterId":null,"attributes":{}},{"id":"0168d40c-cd1f-46b9-b084-5d251e70c171","type":"paragraph","text":"1.2 Put the action in the verb","characterId":null,"attributes":{}},{"id":"15517610-450f-4fc0-8d32-c9d5f52739bf","type":"paragraph","text":"Weak sentences hide their action in nouns. Make a decision becomes decide; conduct an investigation becomes investigate. The sentence gets shorter and stronger at once.","characterId":null,"attributes":{}},{"id":"bae4f491-c5d4-4d2c-9589-7b7d222a22cd","type":"paragraph","text":"1.3 Adverbs and the verbs they prop up","characterId":null,"attributes":{}},{"id":"b547fff6-c19c-4858-9b73-27f5b18d368c","type":"paragraph","text":"If you use an adverb, make it earn its place. Ran quickly is usually sprinted; said loudly is usually shouted. Choose the verb that already means what the adverb was trying to add.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.308Z"},{"id":"ad317a17-b9da-40f3-a365-42abe2b8c406","projectId":"65fc93a1-8486-4aee-b72f-b3221578b3fe","unitId":"cd424198-f9b1-41cc-9c70-a2f1e83a2a83","title":"What a paragraph does","summary":"","status":"written","orderKey":"V","inScript":true,"headingShown":true,"manuscript":{"elements":[{"id":"dd07c119-a456-44f2-adf8-bd1989b9c08c","type":"paragraph","text":"A paragraph is a unit of thought. It opens with a claim, supports it, and hands the reader on to the next.","characterId":null,"attributes":{}}]},"revisionName":"Imported","revisions":[],"color":null,"visual":"","imageAssetId":null,"seconds":0,"headSeconds":0,"tailSeconds":0,"origin":null,"createdAt":"2026-11-12T04:52:00.307Z","updatedAt":"2026-11-12T04:52:00.308Z"}],"markers":[{"id":"857708d5-e2dd-44de