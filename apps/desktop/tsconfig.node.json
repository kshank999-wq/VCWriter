{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  // Main and preload only. Renderer sources — including their tests — are
  // typechecked by tsconfig.web.json, which has the DOM lib they need.
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts"]
}
