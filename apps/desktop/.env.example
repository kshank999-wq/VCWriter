# VC Writer desktop — build-time configuration.
# Copy to .env in this directory. Both values are public (the anon key is bound
# by row level security); the service role key must never appear here.
#
# Leave them empty to build a desktop app with sync switched off: projects are
# files on disk and everything except sync and the capture queue still works.

MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
