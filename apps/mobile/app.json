{
  "expo": {
    "name": "VC Writer Notes",
    "slug": "vcwriter-notes",
    "scheme": "vcwriter",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#c9a45c",
    "ios": {
      "bundleIdentifier": "com.vcwriter.notes",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VC Writer Notes listens so you can dictate a note without looking at your phone.",
        "NSSpeechRecognitionUsageDescription": "Your speech is turned into the words of your note. On this device where it can be, so a walk without signal still works.",
        "NSPhotoLibraryUsageDescription": "VC Writer Notes never reads or changes your photos. It only listens when you dictate and turns what you say into notes.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.vcwriter.notes",
      "versionCode": 1,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.INTERNET"],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#070604"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VC Writer Notes listens so you can dictate a note without looking at your phone.",
          "speechRecognitionPermission": "Your speech is turned into the words of your note.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "site": "https://vc-writer.com"
    }
  }
}
