# Where the app signs in and which site it talks to.
#
# The anon key is publishable by design — it is already in every page of
# vc-writer.com, and what protects the data is row-level security rather than
# the key being secret. It is still read from here rather than written into the
# repository, because a key in a file is a key nobody rotates.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<the publishable anon key>
EXPO_PUBLIC_SITE=https://vc-writer.com
